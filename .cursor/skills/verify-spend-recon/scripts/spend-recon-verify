#!/usr/bin/env bash
# Drive the spend-recon Compose stack and keep proof outside it.
# Evidence lives in /tmp/spend-recon-verify-evidence/$RUN_ID and is never deleted.
set -euo pipefail

# scripts -> verify-spend-recon -> skills -> .cursor -> repository root
ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
COMPOSE_FILE="$ROOT/docker-compose.yml"

usage() {
  echo "usage: RUN_ID=<id> $0 launch|doctor|drive <feature>|evidence|cleanup" >&2
  echo "features: health prometheus scalar schema audit ingest" >&2
  exit 2
}

require_run_id() {
  if [[ -z "${RUN_ID:-}" ]]; then
    echo "Set RUN_ID. Example: RUN_ID=proof1 $0 launch" >&2
    exit 2
  fi
  if [[ ! "$RUN_ID" =~ ^[A-Za-z0-9_-]+$ ]]; then
    echo "RUN_ID may contain only letters, digits, underscore, and hyphen." >&2
    exit 2
  fi
}

evidence_dir() {
  printf '%s\n' "/tmp/spend-recon-verify-evidence/${RUN_ID}"
}

project_name() {
  local slug
  slug="$(printf '%s' "$RUN_ID" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')"
  printf 'sr%s\n' "$slug"
}

compose() {
  docker compose -p "$PROJECT" -f "$COMPOSE_FILE" "$@"
}

port_open() {
  local port="$1"
  (echo >/dev/tcp/127.0.0.1/"$port") >/dev/null 2>&1
}

load_run() {
  require_run_id
  EVIDENCE_DIR="$(evidence_dir)"
  local envf="$EVIDENCE_DIR/run.env"
  if [[ ! -f "$envf" ]]; then
    echo "No run at $envf. Launch this RUN_ID first." >&2
    exit 1
  fi
  PROJECT="$(sed -n 's/^PROJECT=//p' "$envf")"
  BASE_URL="$(sed -n 's/^BASE_URL=//p' "$envf")"
  if [[ -z "$PROJECT" || -z "$BASE_URL" ]]; then
    echo "run.env is missing PROJECT or BASE_URL." >&2
    exit 1
  fi
}

psql_exec() {
  compose exec -T postgres psql -v ON_ERROR_STOP=1 -U spendrecon -d spendrecon "$@"
}

launch() {
  require_run_id
  EVIDENCE_DIR="$(evidence_dir)"
  PROJECT="$(project_name)"
  BASE_URL="http://127.0.0.1:8080"
  mkdir -p "$EVIDENCE_DIR/launch"
  cat >"$EVIDENCE_DIR/run.env" <<EOF
RUN_ID=$RUN_ID
PROJECT=$PROJECT
EVIDENCE_DIR=$EVIDENCE_DIR
BASE_URL=$BASE_URL
EOF

  if port_open 8080 || port_open 5432; then
    echo "127.0.0.1:8080 or :5432 is already open." >&2
    echo "This skill publishes those fixed ports, so only one stack can run." >&2
    exit 1
  fi

  echo "Starting compose project $PROJECT"
  compose up --build -d >"$EVIDENCE_DIR/launch/compose-up.txt" 2>&1

  local ready=0 code version i
  for i in $(seq 1 90); do
    code="$(curl -sS --max-time 2 -o "$EVIDENCE_DIR/launch/health.json" -w '%{http_code}' "$BASE_URL/actuator/health" 2>"$EVIDENCE_DIR/launch/health.stderr" || true)"
    version=""
    if version="$(psql_exec -tAc "SELECT version FROM flyway_schema_history WHERE success" 2>/dev/null)"; then
      version="$(printf '%s' "$version" | tr -d '[:space:]')"
    else
      version=""
    fi
    echo "try $i health=$code flyway=${version:-none}" >>"$EVIDENCE_DIR/launch/wait.log"
    if [[ "$code" == "200" ]] && grep -q '"status":"UP"' "$EVIDENCE_DIR/launch/health.json" && [[ "$version" == "1" ]]; then
      printf '%s\n' "$version" >"$EVIDENCE_DIR/launch/flyway-version.txt"
      ready=1
      break
    fi
    sleep 2
  done

  if [[ "$ready" -ne 1 ]]; then
    compose logs --tail 120 >"$EVIDENCE_DIR/launch/logs.txt" 2>&1 || true
    echo "Stack did not become ready. See $EVIDENCE_DIR/launch/logs.txt" >&2
    echo "If the app log says 'Connect timed out' while Postgres is healthy, this host's legacy iptables FORWARD policy may be DROP. A normal Docker install does not need a change. On this kind of VM: sudo iptables-legacy -P FORWARD ACCEPT" >&2
    exit 1
  fi
  echo "Ready at $BASE_URL (flyway version 1). Evidence: $EVIDENCE_DIR"
}

check() {
  local name="$1"
  local ok="$2"
  if [[ "$ok" -eq 0 ]]; then
    echo "PASS $name" | tee -a "$EVIDENCE_DIR/doctor/doctor.txt"
  else
    echo "FAIL $name" | tee -a "$EVIDENCE_DIR/doctor/doctor.txt"
    DOCTOR_FAILED=1
  fi
}

doctor() {
  load_run
  mkdir -p "$EVIDENCE_DIR/doctor"
  : >"$EVIDENCE_DIR/doctor/doctor.txt"
  DOCTOR_FAILED=0

  local app_id port_owner label
  app_id="$(compose ps -q app)"
  if [[ -n "$app_id" ]] && [[ "$(docker inspect -f '{{.State.Running}}' "$app_id")" == "true" ]]; then
    check "app container running" 0
  else
    check "app container running" 1
  fi

  label="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$app_id" 2>/dev/null || true)"
  printf '%s\n' "$label" >"$EVIDENCE_DIR/doctor/compose-project.txt"
  if [[ "$label" == "$PROJECT" ]]; then
    check "compose project is $PROJECT" 0
  else
    check "compose project is $PROJECT" 1
  fi

  port_owner="$(docker ps -q --no-trunc --filter publish=8080)"
  printf '%s\n' "$port_owner" >"$EVIDENCE_DIR/doctor/port-8080-owner.txt"
  if [[ -n "$app_id" && "$port_owner" == "$app_id" ]]; then
    check "port 8080 is owned by this app container" 0
  else
    check "port 8080 is owned by this app container" 1
  fi

  local code
  code="$(curl -sS --max-time 5 -o "$EVIDENCE_DIR/doctor/health.json" -w '%{http_code}' "$BASE_URL/actuator/health" 2>"$EVIDENCE_DIR/doctor/health.stderr" || true)"
  printf '%s\n' "$code" >"$EVIDENCE_DIR/doctor/health-status.txt"
  if [[ "$code" == "200" ]] && grep -q '"status":"UP"' "$EVIDENCE_DIR/doctor/health.json"; then
    check "GET /actuator/health without an API key is UP" 0
  else
    check "GET /actuator/health without an API key is UP" 1
  fi

  local version
  version="$(psql_exec -tAc "SELECT version FROM flyway_schema_history WHERE success" | tr -d '[:space:]')"
  printf '%s\n' "$version" >"$EVIDENCE_DIR/doctor/flyway-version.txt"
  if [[ "$version" == "1" ]]; then
    check "flyway version 1 applied" 0
  else
    check "flyway version 1 applied" 1
  fi

  code="$(curl -sS --max-time 5 -o "$EVIDENCE_DIR/doctor/api-docs.json" -w '%{http_code}' "$BASE_URL/v3/api-docs" 2>"$EVIDENCE_DIR/doctor/api-docs.stderr" || true)"
  if [[ "$code" == "200" ]] && grep -q '"title":"spend-recon"' "$EVIDENCE_DIR/doctor/api-docs.json"; then
    check "openapi title is spend-recon" 0
  else
    check "openapi title is spend-recon" 1
  fi

  if [[ "$DOCTOR_FAILED" -ne 0 ]]; then
    echo "Doctor failed. See $EVIDENCE_DIR/doctor/doctor.txt" >&2
    exit 1
  fi
  echo "Doctor passed. Read routes do not require an API key. POST /transactions and POST /documents do."
}

curl_capture() {
  local dir="$1"
  local url="$2"
  local body="$3"
  local status_file="$4"
  mkdir -p "$dir"
  local code
  code="$(curl -sS --max-time 10 -D "$dir/headers.txt" -o "$body" -w '%{http_code}' "$url" 2>"$dir/stderr.txt")"
  printf '%s\n' "$code" >"$status_file"
  printf '%s\n' "$code"
}

drive_health() {
  local dir="$EVIDENCE_DIR/health"
  mkdir -p "$dir"
  echo "curl $BASE_URL/actuator/health" >"$dir/command.txt"
  local code
  code="$(curl_capture "$dir" "$BASE_URL/actuator/health" "$dir/body.json" "$dir/http-status.txt")"
  [[ "$code" == "200" ]] || { echo "health HTTP $code" >&2; exit 1; }
  grep -q '"status":"UP"' "$dir/body.json" || { echo "health status was not UP" >&2; exit 1; }
  echo "health passed"
}

drive_prometheus() {
  local dir="$EVIDENCE_DIR/prometheus"
  mkdir -p "$dir"
  echo "curl $BASE_URL/actuator/prometheus" >"$dir/command.txt"
  local code
  code="$(curl_capture "$dir" "$BASE_URL/actuator/prometheus" "$dir/body.txt" "$dir/http-status.txt")"
  [[ "$code" == "200" ]] || { echo "prometheus HTTP $code" >&2; exit 1; }
  grep -q 'jvm_memory_used_bytes' "$dir/body.txt" || { echo "prometheus scrape has no jvm_memory_used_bytes" >&2; exit 1; }
  echo "prometheus passed"
}

drive_scalar() {
  local dir="$EVIDENCE_DIR/scalar"
  mkdir -p "$dir"
  {
    echo "curl $BASE_URL/scalar"
    echo "curl $BASE_URL/v3/api-docs"
    echo "curl $BASE_URL/swagger-ui/index.html"
  } >"$dir/command.txt"
  local code
  code="$(curl_capture "$dir" "$BASE_URL/scalar" "$dir/body.html" "$dir/http-status.txt")"
  [[ "$code" == "200" ]] || { echo "scalar HTTP $code" >&2; exit 1; }
  grep -q '/v3/api-docs' "$dir/body.html" || { echo "scalar page does not reference /v3/api-docs" >&2; exit 1; }
  grep -q 'Scalar' "$dir/body.html" || { echo "scalar page has no Scalar marker" >&2; exit 1; }

  code="$(curl -sS --max-time 10 -o "$dir/api-docs.json" -w '%{http_code}' "$BASE_URL/v3/api-docs" 2>"$dir/api-docs.stderr.txt")"
  printf '%s\n' "$code" >"$dir/api-docs-status.txt"
  [[ "$code" == "200" ]] || { echo "api-docs HTTP $code" >&2; exit 1; }
  grep -q '"title":"spend-recon"' "$dir/api-docs.json" || { echo "openapi title was not spend-recon" >&2; exit 1; }

  code="$(curl -sS --max-time 10 -o "$dir/swagger-body.txt" -w '%{http_code}' "$BASE_URL/swagger-ui/index.html" 2>"$dir/swagger.stderr.txt" || true)"
  printf '%s\n' "$code" >"$dir/swagger-status.txt"
  [[ "$code" == "404" ]] || { echo "swagger ui returned $code" >&2; exit 1; }
  echo "scalar passed"
}

drive_schema() {
  local dir="$EVIDENCE_DIR/schema"
  mkdir -p "$dir"
  echo "psql against the database this app migrated" >"$dir/command.txt"
  psql_exec -c "SELECT table_name FROM information_schema.tables WHERE table_schema = 'public' AND table_type = 'BASE TABLE' ORDER BY 1" >"$dir/tables.txt"
  local table
  for table in card_transactions documents matches reconciliation_events idempotency_keys outbox; do
    grep -q "$table" "$dir/tables.txt" || { echo "missing table $table" >&2; exit 1; }
  done
  local hash_count
  hash_count="$(psql_exec -tAc "SELECT count(*) FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'documents' AND column_name = 'content_hash'" | tr -d '[:space:]')"
  printf '%s\n' "$hash_count" >"$dir/content-hash-count.txt"
  [[ "$hash_count" == "0" ]] || { echo "documents.content_hash exists" >&2; exit 1; }
  psql_exec -tAc "SELECT indexdef FROM pg_indexes WHERE indexname = 'matches_one_live_per_document'" >"$dir/indexdef.txt"
  grep -q 'UNIQUE' "$dir/indexdef.txt" && grep -q 'REJECTED' "$dir/indexdef.txt" || { echo "live-match index missing" >&2; exit 1; }
  local version
  version="$(psql_exec -tAc "SELECT version FROM flyway_schema_history WHERE success" | tr -d '[:space:]')"
  printf '%s\n' "$version" >"$dir/flyway-version.txt"
  [[ "$version" == "1" ]] || { echo "flyway version $version" >&2; exit 1; }
  echo "schema passed"
}

drive_audit() {
  local dir="$EVIDENCE_DIR/audit"
  mkdir -p "$dir"
  cat >"$dir/command.sql" <<'SQL'
INSERT INTO card_transactions (
    id, card_owner_id, merchant_raw, merchant_norm, amount_minor, currency, txn_date, status
) VALUES (
    '11111111-1111-1111-1111-111111111111',
    'owner-1', 'Cafe', 'cafe', 1234, 'AUD', DATE '2026-11-21', 'UNMATCHED'
);
INSERT INTO matches (id, transaction_id, status, score)
VALUES (
    '22222222-2222-2222-2222-222222222222',
    '11111111-1111-1111-1111-111111111111',
    'MATCHED', 0.910
);
INSERT INTO reconciliation_events (match_id, event_type, actor, reason)
VALUES (
    '22222222-2222-2222-2222-222222222222',
    'MATCHED', 'verify', 'created'
);
UPDATE reconciliation_events SET reason = 'changed' WHERE match_id = '22222222-2222-2222-2222-222222222222';
DELETE FROM reconciliation_events WHERE match_id = '22222222-2222-2222-2222-222222222222';
SQL
  # Inserts commit on their own. UPDATE and DELETE are run separately so their
  # expected failure does not roll the new event back.
  psql_exec <<'SQL' >"$dir/insert-stdout.txt" 2>"$dir/insert-stderr.txt"
INSERT INTO card_transactions (
    id, card_owner_id, merchant_raw, merchant_norm, amount_minor, currency, txn_date, status
) VALUES (
    '11111111-1111-1111-1111-111111111111',
    'owner-1', 'Cafe', 'cafe', 1234, 'AUD', DATE '2026-11-21', 'UNMATCHED'
);
INSERT INTO matches (id, transaction_id, status, score)
VALUES (
    '22222222-2222-2222-2222-222222222222',
    '11111111-1111-1111-1111-111111111111',
    'MATCHED', 0.910
);
INSERT INTO reconciliation_events (match_id, event_type, actor, reason)
VALUES (
    '22222222-2222-2222-2222-222222222222',
    'MATCHED', 'verify', 'created'
);
SQL

  local code
  set +e
  psql_exec -c "UPDATE reconciliation_events SET reason = 'changed' WHERE match_id = '22222222-2222-2222-2222-222222222222'" >"$dir/update-stdout.txt" 2>"$dir/update-stderr.txt"
  code=$?
  set -e
  printf '%s\n' "$code" >"$dir/update-exit-code.txt"
  [[ "$code" -ne 0 ]] || { echo "UPDATE was allowed" >&2; exit 1; }
  grep -q 'append-only' "$dir/update-stderr.txt" || { echo "UPDATE failed for another reason" >&2; exit 1; }

  set +e
  psql_exec -c "DELETE FROM reconciliation_events WHERE match_id = '22222222-2222-2222-2222-222222222222'" >"$dir/delete-stdout.txt" 2>"$dir/delete-stderr.txt"
  code=$?
  set -e
  printf '%s\n' "$code" >"$dir/delete-exit-code.txt"
  [[ "$code" -ne 0 ]] || { echo "DELETE was allowed" >&2; exit 1; }
  grep -q 'append-only' "$dir/delete-stderr.txt" || { echo "DELETE failed for another reason" >&2; exit 1; }

  psql_exec -tAc "SELECT reason FROM reconciliation_events WHERE match_id = '22222222-2222-2222-2222-222222222222'" | tr -d '[:space:]' >"$dir/reason.txt"
  [[ "$(cat "$dir/reason.txt")" == "created" ]] || { echo "event reason changed" >&2; exit 1; }
  echo "audit passed"
}

post_json() {
  local dir="$1"
  local url="$2"
  local idem="$3"
  local file="$4"
  local api_key="${5:-local-dev-key}"
  mkdir -p "$dir"
  {
    echo "curl -H Content-Type:application/json -H X-API-Key -H Idempotency-Key:$idem --data-binary @$file $url"
  } >"$dir/command.txt"
  local code
  code="$(curl -sS --max-time 30 -D "$dir/headers.txt" -o "$dir/body.json" -w '%{http_code}' \
    -H 'Content-Type: application/json' \
    -H "X-API-Key: $api_key" \
    -H "Idempotency-Key: $idem" \
    --data-binary @"$file" \
    "$url" 2>"$dir/stderr.txt")"
  printf '%s\n' "$code" >"$dir/http-status.txt"
  printf '%s\n' "$code"
}

require_status() {
  local file="$1"
  local want="$2"
  local got
  got="$(tr -d '[:space:]' <"$file")"
  [[ "$got" == "$want" ]] || { echo "expected HTTP $want in $file, got $got" >&2; exit 1; }
}

drive_ingest() {
  local root="$EVIDENCE_DIR/ingest"
  local api="local-dev-key"
  mkdir -p "$root"

  local unauth="$root/unauthenticated"
  mkdir -p "$unauth"
  printf '%s' '{"cardOwnerId":"unauth-owner","merchant":"Cafe","amount":"1.00","currency":"AUD","txnDate":"2026-11-21"}' >"$unauth/request.json"
  echo "curl POST /transactions without X-API-Key" >"$unauth/command.txt"
  local code
  code="$(curl -sS --max-time 20 -D "$unauth/headers.txt" -o "$unauth/body.json" -w '%{http_code}' \
    -H 'Content-Type: application/json' \
    -H 'Idempotency-Key: no-auth' \
    --data-binary @"$unauth/request.json" \
    "$BASE_URL/transactions" 2>"$unauth/stderr.txt")"
  printf '%s\n' "$code" >"$unauth/http-status.txt"
  [[ "$code" == "401" ]] || { echo "unauthenticated HTTP $code" >&2; exit 1; }
  grep -qi 'application/problem+json' "$unauth/headers.txt" || { echo "401 was not problem+json" >&2; exit 1; }

  local number="$root/amount-number"
  mkdir -p "$number"
  printf '%s' '{"cardOwnerId":"number-owner","merchant":"Cafe","amount":12.34,"currency":"AUD","txnDate":"2026-11-21"}' >"$number/request.json"
  code="$(post_json "$number" "$BASE_URL/transactions" "number-key" "$number/request.json" "$api")"
  [[ "$code" == "400" ]] || { echo "json number HTTP $code" >&2; exit 1; }
  local number_rows
  number_rows="$(psql_exec -tAc "SELECT count(*) FROM card_transactions WHERE card_owner_id = 'number-owner'" | tr -d '[:space:]')"
  [[ "$number_rows" == "0" ]] || { echo "json number stored a row" >&2; exit 1; }

  local parallel="$root/parallel"
  mkdir -p "$parallel"
  printf '%s' '{"cardOwnerId":"parallel-owner","merchant":"Parallel Cafe","amount":"10.00","currency":"AUD","txnDate":"2026-11-21"}' >"$parallel/request.json"
  echo "10 parallel curl POST /transactions Idempotency-Key parallel-key-1" >"$parallel/command.txt"
  local i
  for i in $(seq 1 10); do
    curl -sS --max-time 30 -D "$parallel/headers-$i.txt" -o "$parallel/body-$i.json" -w '%{http_code}' \
      -H 'Content-Type: application/json' \
      -H "X-API-Key: $api" \
      -H 'Idempotency-Key: parallel-key-1' \
      --data-binary @"$parallel/request.json" \
      "$BASE_URL/transactions" >"$parallel/status-$i.txt" 2>"$parallel/stderr-$i.txt" &
  done
  wait
  python3 - "$parallel" <<'PY'
import json, pathlib, sys
root = pathlib.Path(sys.argv[1])
statuses = [(root / f"status-{i}.txt").read_text().strip() for i in range(1, 11)]
bodies = [json.loads((root / f"body-{i}.json").read_text()) for i in range(1, 11)]
if statuses != ["201"] * 10:
    raise SystemExit(f"parallel statuses {statuses}")
ids = {body["id"] for body in bodies}
if len(ids) != 1:
    raise SystemExit(f"parallel ids {ids}")
(root / "id.txt").write_text(next(iter(ids)) + "\n")
PY
  code="$(curl -sS --max-time 10 -o "$parallel/prometheus.txt" -w '%{http_code}' "$BASE_URL/actuator/prometheus" 2>"$parallel/prometheus.stderr.txt")"
  [[ "$code" == "200" ]] || { echo "prometheus HTTP $code" >&2; exit 1; }
  local replays
  replays="$(awk '/^idempotent_replays_total / {print $2}' "$parallel/prometheus.txt" | tail -1)"
  python3 -c 'import sys; raise SystemExit(0 if float(sys.argv[1]) == 9 else 1)' "$replays" \
    || { echo "idempotent_replays_total was ${replays:-missing}, want 9" >&2; exit 1; }
  psql_exec -c "SELECT id, amount_minor, btrim(currency) AS currency FROM card_transactions WHERE card_owner_id = 'parallel-owner'" >"$parallel/rows.txt"
  local parallel_count minor
  parallel_count="$(psql_exec -tAc "SELECT count(*) FROM card_transactions WHERE card_owner_id = 'parallel-owner'" | tr -d '[:space:]')"
  minor="$(psql_exec -tAc "SELECT amount_minor FROM card_transactions WHERE card_owner_id = 'parallel-owner'" | tr -d '[:space:]')"
  [[ "$parallel_count" == "1" && "$minor" == "1000" ]] || { echo "parallel row count=$parallel_count minor=$minor" >&2; exit 1; }

  local created="$root/created"
  mkdir -p "$created"
  printf '%s' '{"cardOwnerId":"aud-owner","merchant":"  Cafe   Nero ","amount":"12.34","currency":"aud","txnDate":"2026-11-21","tax":"1.10"}' >"$created/request.json"
  code="$(post_json "$created" "$BASE_URL/transactions" "aud-key-1" "$created/request.json" "$api")"
  [[ "$code" == "201" ]] || { echo "create HTTP $code" >&2; exit 1; }
  psql_exec -c "SELECT amount_minor, btrim(currency) AS currency, tax_minor, merchant_norm, status FROM card_transactions WHERE card_owner_id = 'aud-owner'" >"$created/row.txt"
  grep -q '1234' "$created/row.txt" && grep -q 'AUD' "$created/row.txt" && grep -q '110' "$created/row.txt" \
    && grep -q 'cafe nero' "$created/row.txt" && grep -q 'UNMATCHED' "$created/row.txt" \
    || { echo "AUD row was not 1234/110/cafe nero" >&2; exit 1; }

  local replay="$root/replay"
  mkdir -p "$replay"
  code="$(post_json "$replay" "$BASE_URL/transactions" "aud-key-1" "$created/request.json" "$api")"
  [[ "$code" == "201" ]] || { echo "replay HTTP $code" >&2; exit 1; }
  python3 - "$created/body.json" "$replay/body.json" <<'PY'
import json, pathlib, sys
first = json.loads(pathlib.Path(sys.argv[1]).read_text())
second = json.loads(pathlib.Path(sys.argv[2]).read_text())
if first != second:
    raise SystemExit(f"replay body {second} != {first}")
PY
  local aud_count
  aud_count="$(psql_exec -tAc "SELECT count(*) FROM card_transactions WHERE card_owner_id = 'aud-owner'" | tr -d '[:space:]')"
  [[ "$aud_count" == "1" ]] || { echo "replay created a second AUD row" >&2; exit 1; }

  local mismatch="$root/mismatch"
  mkdir -p "$mismatch"
  printf '%s' '{"cardOwnerId":"aud-owner","merchant":"  Cafe   Nero ","amount":"12.35","currency":"aud","txnDate":"2026-11-21","tax":"1.10"}' >"$mismatch/request.json"
  code="$(post_json "$mismatch" "$BASE_URL/transactions" "aud-key-1" "$mismatch/request.json" "$api")"
  [[ "$code" == "422" ]] || { echo "mismatch HTTP $code" >&2; exit 1; }
  aud_count="$(psql_exec -tAc "SELECT count(*) FROM card_transactions WHERE card_owner_id = 'aud-owner'" | tr -d '[:space:]')"
  [[ "$aud_count" == "1" ]] || { echo "mismatch created a row" >&2; exit 1; }

  local jpy="$root/jpy"
  mkdir -p "$jpy"
  printf '%s' '{"cardOwnerId":"jpy-owner","merchant":"Cafe","amount":"500","currency":"JPY","txnDate":"2026-11-21"}' >"$jpy/request.json"
  code="$(post_json "$jpy" "$BASE_URL/transactions" "jpy-key-1" "$jpy/request.json" "$api")"
  [[ "$code" == "201" ]] || { echo "jpy HTTP $code" >&2; exit 1; }
  local jpy_minor
  jpy_minor="$(psql_exec -tAc "SELECT amount_minor FROM card_transactions WHERE card_owner_id = 'jpy-owner'" | tr -d '[:space:]')"
  [[ "$jpy_minor" == "500" ]] || { echo "jpy minor was $jpy_minor" >&2; exit 1; }
  local jpy_bad="$root/jpy-decimal"
  mkdir -p "$jpy_bad"
  printf '%s' '{"cardOwnerId":"jpy-bad-owner","merchant":"Cafe","amount":"500.0","currency":"JPY","txnDate":"2026-11-21"}' >"$jpy_bad/request.json"
  code="$(post_json "$jpy_bad" "$BASE_URL/transactions" "jpy-bad-key" "$jpy_bad/request.json" "$api")"
  [[ "$code" == "400" ]] || { echo "jpy decimal HTTP $code" >&2; exit 1; }

  local document="$root/document"
  mkdir -p "$document"
  printf '%s' '{"kind":"RECEIPT","cardOwnerId":"doc-owner","merchant":"Cafe","amount":"9.99","currency":"AUD","docDate":"2026-11-21"}' >"$document/request.json"
  code="$(post_json "$document" "$BASE_URL/documents" "doc-key-1" "$document/request.json" "$api")"
  [[ "$code" == "201" ]] || { echo "document HTTP $code" >&2; exit 1; }
  psql_exec -c "SELECT kind, amount_minor FROM documents WHERE card_owner_id = 'doc-owner'" >"$document/row.txt"
  grep -q 'RECEIPT' "$document/row.txt" && grep -q '999' "$document/row.txt" || { echo "document row missing" >&2; exit 1; }

  local inflight="$root/in-flight"
  mkdir -p "$inflight"
  printf '%s' '{"cardOwnerId":"inflight-owner","merchant":"Cafe","amount":"3.00","currency":"AUD","txnDate":"2026-11-21"}' >"$inflight/request.json"
  local hash
  hash="$(sha256sum "$inflight/request.json" | awk '{print $1}')"
  printf '%s\n' "$hash" >"$inflight/request.sha256"
  psql_exec -v hash="$hash" <<'SQL' >"$inflight/insert-stdout.txt" 2>"$inflight/insert-stderr.txt"
INSERT INTO idempotency_keys (key, endpoint, request_hash)
VALUES ('inflight-key', 'POST /transactions', :'hash');
SQL
  code="$(post_json "$inflight" "$BASE_URL/transactions" "inflight-key" "$inflight/request.json" "$api")"
  [[ "$code" == "409" ]] || { echo "in-flight HTTP $code" >&2; exit 1; }
  grep -qi '^retry-after: 1' "$inflight/headers.txt" || { echo "missing Retry-After: 1" >&2; cat "$inflight/headers.txt" >&2; exit 1; }
  local inflight_rows
  inflight_rows="$(psql_exec -tAc "SELECT count(*) FROM card_transactions WHERE card_owner_id = 'inflight-owner'" | tr -d '[:space:]')"
  [[ "$inflight_rows" == "0" ]] || { echo "in-flight stored a transaction" >&2; exit 1; }

  echo "ingest passed"
}

drive() {
  load_run
  local feature="${1:-}"
  case "$feature" in
    health) drive_health ;;
    prometheus) drive_prometheus ;;
    scalar) drive_scalar ;;
    schema) drive_schema ;;
    audit) drive_audit ;;
    ingest) drive_ingest ;;
    *)
      echo "Unknown feature '$feature'." >&2
      usage
      ;;
  esac
}

show_evidence() {
  load_run
  echo "$EVIDENCE_DIR"
  find "$EVIDENCE_DIR" -type f | sort
}

cleanup() {
  load_run
  echo "Stopping compose project $PROJECT"
  compose down --remove-orphans
  echo "Evidence kept at $EVIDENCE_DIR"
}

cmd="${1:-}"
case "$cmd" in
  launch) launch ;;
  doctor) doctor ;;
  drive) drive "${2:-}" ;;
  evidence) show_evidence ;;
  cleanup) cleanup ;;
  *) usage ;;
esac
