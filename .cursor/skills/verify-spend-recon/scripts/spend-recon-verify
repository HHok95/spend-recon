#!/usr/bin/env bash
# Drive the spend-recon Compose stack and keep proof outside it.
# Evidence lives in /tmp/spend-recon-verify-evidence/$RUN_ID and is never deleted.
set -euo pipefail

# scripts -> verify-spend-recon -> skills -> .cursor -> repository root
ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
COMPOSE_FILE="$ROOT/docker-compose.yml"

usage() {
  echo "usage: RUN_ID=<id> $0 launch|doctor|drive <feature>|evidence|cleanup" >&2
  echo "features: health prometheus scalar schema audit ingest reconcile decisions grafana kind" >&2
  exit 2
}

require_run_id() {
  if [[ -z "${RUN_ID:-}" ]]; then
    echo "Set RUN_ID. Example: RUN_ID=proof1 $0 launch" >&2
    exit 2
  fi
  if [[ ! "$RUN_ID" =~ ^[A-Za-z0-9_-]+$ ]]; then
    echo "RUN_ID may contain only letters, digits, underscore, and hyphen." >&2
    exit 2
  fi
}

evidence_dir() {
  printf '%s\n' "/tmp/spend-recon-verify-evidence/${RUN_ID}"
}

project_name() {
  local slug
  slug="$(printf '%s' "$RUN_ID" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')"
  printf 'sr%s\n' "$slug"
}

compose() {
  docker compose -p "$PROJECT" -f "$COMPOSE_FILE" "$@"
}

port_open() {
  local port="$1"
  (echo >/dev/tcp/127.0.0.1/"$port") >/dev/null 2>&1
}

load_run() {
  require_run_id
  EVIDENCE_DIR="$(evidence_dir)"
  local envf="$EVIDENCE_DIR/run.env"
  if [[ ! -f "$envf" ]]; then
    echo "No run at $envf. Launch this RUN_ID first." >&2
    exit 1
  fi
  PROJECT="$(sed -n 's/^PROJECT=//p' "$envf")"
  BASE_URL="$(sed -n 's/^BASE_URL=//p' "$envf")"
  if [[ -z "$PROJECT" || -z "$BASE_URL" ]]; then
    echo "run.env is missing PROJECT or BASE_URL." >&2
    exit 1
  fi
}

psql_exec() {
  compose exec -T postgres psql -v ON_ERROR_STOP=1 -U spendrecon -d spendrecon "$@"
}

# Highest V<n> filename. The check follows the files, so a later migration still passes.
highest_migration_version() {
  local dir="$ROOT/src/main/resources/db/migration"
  local highest="" n file base
  local saw=0
  for file in "$dir"/V*__*.sql; do
    [[ -f "$file" ]] || continue
    base="$(basename "$file")"
    [[ "$base" =~ ^V([0-9]+)__ ]] || continue
    n=$((10#${BASH_REMATCH[1]}))
    if [[ "$saw" -eq 0 || "$n" -gt "$highest" ]]; then
      highest="$n"
      saw=1
    fi
  done
  if [[ "$saw" -eq 0 ]]; then
    echo "No V<n>__*.sql files in $dir" >&2
    return 1
  fi
  printf '%s\n' "$highest"
}

# Sets FLYWAY_VERSION to the highest successful version (empty when none)
# and FLYWAY_FAILED to the number of rows with success = false.
# Pass "quiet" while Postgres may still be starting.
flyway_read() {
  local quiet="${1:-}"
  local version failed
  FLYWAY_VERSION=""
  FLYWAY_FAILED=""
  if [[ "$quiet" == "quiet" ]]; then
    if ! version="$(psql_exec -tAc "SELECT max(version::int) FROM flyway_schema_history WHERE success" 2>/dev/null)"; then
      return 1
    fi
    if ! failed="$(psql_exec -tAc "SELECT count(*) FROM flyway_schema_history WHERE success = false" 2>/dev/null)"; then
      return 1
    fi
  else
    if ! version="$(psql_exec -tAc "SELECT max(version::int) FROM flyway_schema_history WHERE success")"; then
      return 1
    fi
    if ! failed="$(psql_exec -tAc "SELECT count(*) FROM flyway_schema_history WHERE success = false")"; then
      return 1
    fi
  fi
  FLYWAY_VERSION="$(printf '%s' "$version" | tr -d '[:space:]')"
  FLYWAY_FAILED="$(printf '%s' "$failed" | tr -d '[:space:]')"
}

launch() {
  require_run_id
  EVIDENCE_DIR="$(evidence_dir)"
  PROJECT="$(project_name)"
  BASE_URL="http://127.0.0.1:8080"
  mkdir -p "$EVIDENCE_DIR/launch"
  cat >"$EVIDENCE_DIR/run.env" <<EOF
RUN_ID=$RUN_ID
PROJECT=$PROJECT
EVIDENCE_DIR=$EVIDENCE_DIR
BASE_URL=$BASE_URL
PROM_URL=http://127.0.0.1:9090
GRAFANA_URL=http://127.0.0.1:3000
EOF

  if port_open 8080 || port_open 5432 || port_open 9090 || port_open 3000; then
    echo "127.0.0.1:8080, :5432, :9090, or :3000 is already open." >&2
    echo "This skill publishes those fixed ports, so only one stack can run." >&2
    exit 1
  fi

  echo "Starting compose project $PROJECT"
  compose up --build -d >"$EVIDENCE_DIR/launch/compose-up.txt" 2>&1

  local ready=0 code version failed expected i
  expected="$(highest_migration_version)"
  for i in $(seq 1 90); do
    code="$(curl -sS --max-time 2 -o "$EVIDENCE_DIR/launch/health.json" -w '%{http_code}' "$BASE_URL/actuator/health" 2>"$EVIDENCE_DIR/launch/health.stderr" || true)"
    version=""
    failed=""
    if flyway_read quiet; then
      version="$FLYWAY_VERSION"
      failed="$FLYWAY_FAILED"
    fi
    echo "try $i health=$code flyway=${version:-none} failed=${failed:-none} expected=$expected" >>"$EVIDENCE_DIR/launch/wait.log"
    if [[ "$code" == "200" ]] && grep -q '"status":"UP"' "$EVIDENCE_DIR/launch/health.json" \
      && [[ -n "$version" && "$failed" == "0" && "$version" == "$expected" ]]; then
      printf '%s\n' "$version" >"$EVIDENCE_DIR/launch/flyway-version.txt"
      ready=1
      break
    fi
    sleep 2
  done

  if [[ "$ready" -ne 1 ]]; then
    compose logs --tail 120 >"$EVIDENCE_DIR/launch/logs.txt" 2>&1 || true
    echo "Stack did not become ready. See $EVIDENCE_DIR/launch/logs.txt" >&2
    echo "If the app log says 'Connect timed out' while Postgres is healthy, this host's legacy iptables FORWARD policy may be DROP. A normal Docker install does not need a change. On this kind of VM: sudo iptables-legacy -P FORWARD ACCEPT" >&2
    exit 1
  fi
  echo "Ready at $BASE_URL (flyway version $version, no failed migrations). Prometheus http://127.0.0.1:9090 Grafana http://127.0.0.1:3000. Evidence: $EVIDENCE_DIR"
}

check() {
  local name="$1"
  local ok="$2"
  if [[ "$ok" -eq 0 ]]; then
    echo "PASS $name" | tee -a "$EVIDENCE_DIR/doctor/doctor.txt"
  else
    echo "FAIL $name" | tee -a "$EVIDENCE_DIR/doctor/doctor.txt"
    DOCTOR_FAILED=1
  fi
}

doctor() {
  load_run
  mkdir -p "$EVIDENCE_DIR/doctor"
  : >"$EVIDENCE_DIR/doctor/doctor.txt"
  DOCTOR_FAILED=0

  local app_id port_owner label
  app_id="$(compose ps -q app)"
  if [[ -n "$app_id" ]] && [[ "$(docker inspect -f '{{.State.Running}}' "$app_id")" == "true" ]]; then
    check "app container running" 0
  else
    check "app container running" 1
  fi

  label="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$app_id" 2>/dev/null || true)"
  printf '%s\n' "$label" >"$EVIDENCE_DIR/doctor/compose-project.txt"
  if [[ "$label" == "$PROJECT" ]]; then
    check "compose project is $PROJECT" 0
  else
    check "compose project is $PROJECT" 1
  fi

  port_owner="$(docker ps -q --no-trunc --filter publish=8080)"
  printf '%s\n' "$port_owner" >"$EVIDENCE_DIR/doctor/port-8080-owner.txt"
  if [[ -n "$app_id" && "$port_owner" == "$app_id" ]]; then
    check "port 8080 is owned by this app container" 0
  else
    check "port 8080 is owned by this app container" 1
  fi

  local code
  code="$(curl -sS --max-time 5 -o "$EVIDENCE_DIR/doctor/health.json" -w '%{http_code}' "$BASE_URL/actuator/health" 2>"$EVIDENCE_DIR/doctor/health.stderr" || true)"
  printf '%s\n' "$code" >"$EVIDENCE_DIR/doctor/health-status.txt"
  if [[ "$code" == "200" ]] && grep -q '"status":"UP"' "$EVIDENCE_DIR/doctor/health.json"; then
    check "GET /actuator/health without an API key is UP" 0
  else
    check "GET /actuator/health without an API key is UP" 1
  fi

  local version failed expected
  expected="$(highest_migration_version)"
  version=""
  failed=""
  if flyway_read; then
    version="$FLYWAY_VERSION"
    failed="$FLYWAY_FAILED"
  fi
  printf '%s\n' "$version" >"$EVIDENCE_DIR/doctor/flyway-version.txt"
  if [[ -n "$version" && "$failed" == "0" && "$version" == "$expected" ]]; then
    check "flyway version $expected applied with no failures" 0
  else
    check "flyway version $expected applied with no failures" 1
  fi

  code="$(curl -sS --max-time 5 -o "$EVIDENCE_DIR/doctor/api-docs.json" -w '%{http_code}' "$BASE_URL/v3/api-docs" 2>"$EVIDENCE_DIR/doctor/api-docs.stderr" || true)"
  if [[ "$code" == "200" ]] && grep -q '"title":"spend-recon"' "$EVIDENCE_DIR/doctor/api-docs.json"; then
    check "openapi title is spend-recon" 0
  else
    check "openapi title is spend-recon" 1
  fi

  local prom_id graf_id
  prom_id="$(compose ps -q prometheus)"
  if [[ -n "$prom_id" ]] && [[ "$(docker inspect -f '{{.State.Running}}' "$prom_id")" == "true" ]]; then
    check "prometheus container running" 0
  else
    check "prometheus container running" 1
  fi
  port_owner="$(docker ps -q --no-trunc --filter publish=9090)"
  printf '%s\n' "$port_owner" >"$EVIDENCE_DIR/doctor/port-9090-owner.txt"
  if [[ -n "$prom_id" && "$port_owner" == "$prom_id" ]]; then
    check "port 9090 is owned by this prometheus container" 0
  else
    check "port 9090 is owned by this prometheus container" 1
  fi

  graf_id="$(compose ps -q grafana)"
  if [[ -n "$graf_id" ]] && [[ "$(docker inspect -f '{{.State.Running}}' "$graf_id")" == "true" ]]; then
    check "grafana container running" 0
  else
    check "grafana container running" 1
  fi
  port_owner="$(docker ps -q --no-trunc --filter publish=3000)"
  printf '%s\n' "$port_owner" >"$EVIDENCE_DIR/doctor/port-3000-owner.txt"
  if [[ -n "$graf_id" && "$port_owner" == "$graf_id" ]]; then
    check "port 3000 is owned by this grafana container" 0
  else
    check "port 3000 is owned by this grafana container" 1
  fi

  if [[ "$DOCTOR_FAILED" -ne 0 ]]; then
    echo "Doctor failed. See $EVIDENCE_DIR/doctor/doctor.txt" >&2
    exit 1
  fi
  echo "Doctor passed. Read routes do not require an API key. POST /transactions, POST /documents, POST /reconcile/{txnId}, POST /matches/{id}/approve, and POST /matches/{id}/reject do. Grafana's local login is admin / admin."
}

curl_capture() {
  local dir="$1"
  local url="$2"
  local body="$3"
  local status_file="$4"
  mkdir -p "$dir"
  local code
  code="$(curl -sS --max-time 10 -D "$dir/headers.txt" -o "$body" -w '%{http_code}' "$url" 2>"$dir/stderr.txt")"
  printf '%s\n' "$code" >"$status_file"
  printf '%s\n' "$code"
}

drive_health() {
  local dir="$EVIDENCE_DIR/health"
  mkdir -p "$dir"
  echo "curl $BASE_URL/actuator/health" >"$dir/command.txt"
  local code
  code="$(curl_capture "$dir" "$BASE_URL/actuator/health" "$dir/body.json" "$dir/http-status.txt")"
  [[ "$code" == "200" ]] || { echo "health HTTP $code" >&2; exit 1; }
  grep -q '"status":"UP"' "$dir/body.json" || { echo "health status was not UP" >&2; exit 1; }
  echo "health passed"
}

drive_prometheus() {
  local dir="$EVIDENCE_DIR/prometheus"
  mkdir -p "$dir"
  echo "curl $BASE_URL/actuator/prometheus" >"$dir/command.txt"
  local code
  code="$(curl_capture "$dir" "$BASE_URL/actuator/prometheus" "$dir/body.txt" "$dir/http-status.txt")"
  [[ "$code" == "200" ]] || { echo "prometheus HTTP $code" >&2; exit 1; }
  grep -q 'jvm_memory_used_bytes' "$dir/body.txt" || { echo "prometheus scrape has no jvm_memory_used_bytes" >&2; exit 1; }
  echo "prometheus passed"
}

drive_scalar() {
  local dir="$EVIDENCE_DIR/scalar"
  mkdir -p "$dir"
  {
    echo "curl $BASE_URL/scalar"
    echo "curl $BASE_URL/v3/api-docs"
    echo "curl $BASE_URL/swagger-ui/index.html"
  } >"$dir/command.txt"
  local code
  code="$(curl_capture "$dir" "$BASE_URL/scalar" "$dir/body.html" "$dir/http-status.txt")"
  [[ "$code" == "200" ]] || { echo "scalar HTTP $code" >&2; exit 1; }
  grep -q '/v3/api-docs' "$dir/body.html" || { echo "scalar page does not reference /v3/api-docs" >&2; exit 1; }
  grep -q 'Scalar' "$dir/body.html" || { echo "scalar page has no Scalar marker" >&2; exit 1; }

  code="$(curl -sS --max-time 10 -o "$dir/api-docs.json" -w '%{http_code}' "$BASE_URL/v3/api-docs" 2>"$dir/api-docs.stderr.txt")"
  printf '%s\n' "$code" >"$dir/api-docs-status.txt"
  [[ "$code" == "200" ]] || { echo "api-docs HTTP $code" >&2; exit 1; }
  grep -q '"title":"spend-recon"' "$dir/api-docs.json" || { echo "openapi title was not spend-recon" >&2; exit 1; }

  code="$(curl -sS --max-time 10 -o "$dir/swagger-body.txt" -w '%{http_code}' "$BASE_URL/swagger-ui/index.html" 2>"$dir/swagger.stderr.txt" || true)"
  printf '%s\n' "$code" >"$dir/swagger-status.txt"
  [[ "$code" == "404" ]] || { echo "swagger ui returned $code" >&2; exit 1; }
  echo "scalar passed"
}

drive_schema() {
  local dir="$EVIDENCE_DIR/schema"
  mkdir -p "$dir"
  echo "psql against the database this app migrated" >"$dir/command.txt"
  psql_exec -c "SELECT table_name FROM information_schema.tables WHERE table_schema = 'public' AND table_type = 'BASE TABLE' ORDER BY 1" >"$dir/tables.txt"
  local table
  for table in card_transactions documents matches reconciliation_events idempotency_keys outbox tenants demo_sessions; do
    grep -q "$table" "$dir/tables.txt" || { echo "missing table $table" >&2; exit 1; }
  done
  local hash_count
  hash_count="$(psql_exec -tAc "SELECT count(*) FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'documents' AND column_name = 'content_hash'" | tr -d '[:space:]')"
  printf '%s\n' "$hash_count" >"$dir/content-hash-count.txt"
  [[ "$hash_count" == "0" ]] || { echo "documents.content_hash exists" >&2; exit 1; }
  psql_exec -tAc "SELECT indexdef FROM pg_indexes WHERE indexname = 'matches_one_live_per_document'" >"$dir/indexdef.txt"
  grep -q 'UNIQUE' "$dir/indexdef.txt" && grep -q 'REJECTED' "$dir/indexdef.txt" || { echo "live-match index missing" >&2; exit 1; }
  psql_exec -tAc "SELECT indexdef FROM pg_indexes WHERE indexname = 'outbox_unpublished'" >"$dir/outbox-index.txt"
  grep -q 'published_at IS NULL' "$dir/outbox-index.txt" || { echo "outbox unpublished index missing" >&2; exit 1; }
  psql_exec -tAc "SELECT indexdef FROM pg_indexes WHERE indexname = 'matches_status'" >"$dir/matches-status-index.txt"
  grep -q '(status)' "$dir/matches-status-index.txt" || { echo "matches status index missing" >&2; exit 1; }
  local version failed expected
  expected="$(highest_migration_version)"
  if ! flyway_read; then
    echo "could not read flyway_schema_history" >&2
    exit 1
  fi
  version="$FLYWAY_VERSION"
  failed="$FLYWAY_FAILED"
  printf '%s\n' "$version" >"$dir/flyway-version.txt"
  [[ -n "$version" && "$failed" == "0" && "$version" == "$expected" ]] \
    || { echo "flyway version ${version:-none}, expected $expected, failed rows ${failed:-unknown}" >&2; exit 1; }
  echo "schema passed"
}

drive_audit() {
  local dir="$EVIDENCE_DIR/audit"
  mkdir -p "$dir"
  cat >"$dir/command.sql" <<'SQL'
INSERT INTO card_transactions (
    id, card_owner_id, merchant_raw, merchant_norm, amount_minor, currency, txn_date, status
) VALUES (
    '11111111-1111-1111-1111-111111111111',
    'owner-1', 'Cafe', 'cafe', 1234, 'AUD', DATE '2026-11-21', 'UNMATCHED'
);
INSERT INTO matches (id, transaction_id, status, score, exception_type)
VALUES (
    '22222222-2222-2222-2222-222222222222',
    '11111111-1111-1111-1111-111111111111',
    'EXCEPTION', NULL, 'NO_CANDIDATE'
);
INSERT INTO reconciliation_events (match_id, event_type, actor, reason)
VALUES (
    '22222222-2222-2222-2222-222222222222',
    'MATCHED', 'verify', 'created'
);
UPDATE reconciliation_events SET reason = 'changed' WHERE match_id = '22222222-2222-2222-2222-222222222222';
DELETE FROM reconciliation_events WHERE match_id = '22222222-2222-2222-2222-222222222222';
SQL
  # Inserts commit on their own. UPDATE and DELETE are run separately so their
  # expected failure does not roll the new event back.
  psql_exec <<'SQL' >"$dir/insert-stdout.txt" 2>"$dir/insert-stderr.txt"
INSERT INTO card_transactions (
    id, card_owner_id, merchant_raw, merchant_norm, amount_minor, currency, txn_date, status
) VALUES (
    '11111111-1111-1111-1111-111111111111',
    'owner-1', 'Cafe', 'cafe', 1234, 'AUD', DATE '2026-11-21', 'UNMATCHED'
);
INSERT INTO matches (id, transaction_id, status, score, exception_type)
VALUES (
    '22222222-2222-2222-2222-222222222222',
    '11111111-1111-1111-1111-111111111111',
    'EXCEPTION', NULL, 'NO_CANDIDATE'
);
INSERT INTO reconciliation_events (match_id, event_type, actor, reason)
VALUES (
    '22222222-2222-2222-2222-222222222222',
    'MATCHED', 'verify', 'created'
);
SQL

  local code
  set +e
  psql_exec -c "UPDATE reconciliation_events SET reason = 'changed' WHERE match_id = '22222222-2222-2222-2222-222222222222'" >"$dir/update-stdout.txt" 2>"$dir/update-stderr.txt"
  code=$?
  set -e
  printf '%s\n' "$code" >"$dir/update-exit-code.txt"
  [[ "$code" -ne 0 ]] || { echo "UPDATE was allowed" >&2; exit 1; }
  grep -q 'append-only' "$dir/update-stderr.txt" || { echo "UPDATE failed for another reason" >&2; exit 1; }

  set +e
  psql_exec -c "DELETE FROM reconciliation_events WHERE match_id = '22222222-2222-2222-2222-222222222222'" >"$dir/delete-stdout.txt" 2>"$dir/delete-stderr.txt"
  code=$?
  set -e
  printf '%s\n' "$code" >"$dir/delete-exit-code.txt"
  [[ "$code" -ne 0 ]] || { echo "DELETE was allowed" >&2; exit 1; }
  grep -q 'append-only' "$dir/delete-stderr.txt" || { echo "DELETE failed for another reason" >&2; exit 1; }

  psql_exec -tAc "SELECT reason FROM reconciliation_events WHERE match_id = '22222222-2222-2222-2222-222222222222'" | tr -d '[:space:]' >"$dir/reason.txt"
  [[ "$(cat "$dir/reason.txt")" == "created" ]] || { echo "event reason changed" >&2; exit 1; }
  echo "audit passed"
}

post_json() {
  local dir="$1"
  local url="$2"
  local idem="$3"
  local file="$4"
  local api_key="${5:-local-dev-key}"
  mkdir -p "$dir"
  {
    echo "curl -H Content-Type:application/json -H X-API-Key -H Idempotency-Key:$idem --data-binary @$file $url"
  } >"$dir/command.txt"
  local code
  code="$(curl -sS --max-time 30 -D "$dir/headers.txt" -o "$dir/body.json" -w '%{http_code}' \
    -H 'Content-Type: application/json' \
    -H "X-API-Key: $api_key" \
    -H "Idempotency-Key: $idem" \
    --data-binary @"$file" \
    "$url" 2>"$dir/stderr.txt")"
  printf '%s\n' "$code" >"$dir/http-status.txt"
  printf '%s\n' "$code"
}

require_status() {
  local file="$1"
  local want="$2"
  local got
  got="$(tr -d '[:space:]' <"$file")"
  [[ "$got" == "$want" ]] || { echo "expected HTTP $want in $file, got $got" >&2; exit 1; }
}

drive_ingest() {
  local root="$EVIDENCE_DIR/ingest"
  local api="local-dev-key"
  mkdir -p "$root"

  local unauth="$root/unauthenticated"
  mkdir -p "$unauth"
  printf '%s' '{"cardOwnerId":"unauth-owner","merchant":"Cafe","amount":"1.00","currency":"AUD","txnDate":"2026-11-21"}' >"$unauth/request.json"
  echo "curl POST /transactions without X-API-Key" >"$unauth/command.txt"
  local code
  code="$(curl -sS --max-time 20 -D "$unauth/headers.txt" -o "$unauth/body.json" -w '%{http_code}' \
    -H 'Content-Type: application/json' \
    -H 'Idempotency-Key: no-auth' \
    --data-binary @"$unauth/request.json" \
    "$BASE_URL/transactions" 2>"$unauth/stderr.txt")"
  printf '%s\n' "$code" >"$unauth/http-status.txt"
  [[ "$code" == "401" ]] || { echo "unauthenticated HTTP $code" >&2; exit 1; }
  grep -qi 'application/problem+json' "$unauth/headers.txt" || { echo "401 was not problem+json" >&2; exit 1; }

  local number="$root/amount-number"
  mkdir -p "$number"
  printf '%s' '{"cardOwnerId":"number-owner","merchant":"Cafe","amount":12.34,"currency":"AUD","txnDate":"2026-11-21"}' >"$number/request.json"
  code="$(post_json "$number" "$BASE_URL/transactions" "number-key" "$number/request.json" "$api")"
  [[ "$code" == "400" ]] || { echo "json number HTTP $code" >&2; exit 1; }
  local number_rows
  number_rows="$(psql_exec -tAc "SELECT count(*) FROM card_transactions WHERE card_owner_id = 'number-owner'" | tr -d '[:space:]')"
  [[ "$number_rows" == "0" ]] || { echo "json number stored a row" >&2; exit 1; }

  local parallel="$root/parallel"
  mkdir -p "$parallel"
  printf '%s' '{"cardOwnerId":"parallel-owner","merchant":"Parallel Cafe","amount":"10.00","currency":"AUD","txnDate":"2026-11-21"}' >"$parallel/request.json"
  echo "10 parallel curl POST /transactions Idempotency-Key parallel-key-1" >"$parallel/command.txt"
  local i
  for i in $(seq 1 10); do
    curl -sS --max-time 30 -D "$parallel/headers-$i.txt" -o "$parallel/body-$i.json" -w '%{http_code}' \
      -H 'Content-Type: application/json' \
      -H "X-API-Key: $api" \
      -H 'Idempotency-Key: parallel-key-1' \
      --data-binary @"$parallel/request.json" \
      "$BASE_URL/transactions" >"$parallel/status-$i.txt" 2>"$parallel/stderr-$i.txt" &
  done
  wait
  python3 - "$parallel" <<'PY'
import json, pathlib, sys
root = pathlib.Path(sys.argv[1])
statuses = [(root / f"status-{i}.txt").read_text().strip() for i in range(1, 11)]
bodies = [json.loads((root / f"body-{i}.json").read_text()) for i in range(1, 11)]
if statuses != ["201"] * 10:
    raise SystemExit(f"parallel statuses {statuses}")
ids = {body["id"] for body in bodies}
if len(ids) != 1:
    raise SystemExit(f"parallel ids {ids}")
(root / "id.txt").write_text(next(iter(ids)) + "\n")
PY
  code="$(curl -sS --max-time 10 -o "$parallel/prometheus.txt" -w '%{http_code}' "$BASE_URL/actuator/prometheus" 2>"$parallel/prometheus.stderr.txt")"
  [[ "$code" == "200" ]] || { echo "prometheus HTTP $code" >&2; exit 1; }
  local replays
  replays="$(awk '/^idempotent_replays_total / {print $2}' "$parallel/prometheus.txt" | tail -1)"
  python3 -c 'import sys; raise SystemExit(0 if float(sys.argv[1]) == 9 else 1)' "$replays" \
    || { echo "idempotent_replays_total was ${replays:-missing}, want 9" >&2; exit 1; }
  psql_exec -c "SELECT id, amount_minor, btrim(currency) AS currency FROM card_transactions WHERE card_owner_id = 'parallel-owner'" >"$parallel/rows.txt"
  local parallel_count minor
  parallel_count="$(psql_exec -tAc "SELECT count(*) FROM card_transactions WHERE card_owner_id = 'parallel-owner'" | tr -d '[:space:]')"
  minor="$(psql_exec -tAc "SELECT amount_minor FROM card_transactions WHERE card_owner_id = 'parallel-owner'" | tr -d '[:space:]')"
  [[ "$parallel_count" == "1" && "$minor" == "1000" ]] || { echo "parallel row count=$parallel_count minor=$minor" >&2; exit 1; }

  local created="$root/created"
  mkdir -p "$created"
  printf '%s' '{"cardOwnerId":"aud-owner","merchant":"  Cafe   Nero ","amount":"12.34","currency":"aud","txnDate":"2026-11-21","tax":"1.10"}' >"$created/request.json"
  code="$(post_json "$created" "$BASE_URL/transactions" "aud-key-1" "$created/request.json" "$api")"
  [[ "$code" == "201" ]] || { echo "create HTTP $code" >&2; exit 1; }
  psql_exec -c "SELECT amount_minor, btrim(currency) AS currency, tax_minor, merchant_norm, status FROM card_transactions WHERE card_owner_id = 'aud-owner'" >"$created/row.txt"
  grep -q '1234' "$created/row.txt" && grep -q 'AUD' "$created/row.txt" && grep -q '110' "$created/row.txt" \
    && grep -q 'cafe nero' "$created/row.txt" && grep -q 'UNMATCHED' "$created/row.txt" \
    || { echo "AUD row was not 1234/110/cafe nero" >&2; exit 1; }

  local replay="$root/replay"
  mkdir -p "$replay"
  code="$(post_json "$replay" "$BASE_URL/transactions" "aud-key-1" "$created/request.json" "$api")"
  [[ "$code" == "201" ]] || { echo "replay HTTP $code" >&2; exit 1; }
  python3 - "$created/body.json" "$replay/body.json" <<'PY'
import json, pathlib, sys
first = json.loads(pathlib.Path(sys.argv[1]).read_text())
second = json.loads(pathlib.Path(sys.argv[2]).read_text())
if first != second:
    raise SystemExit(f"replay body {second} != {first}")
PY
  local aud_count
  aud_count="$(psql_exec -tAc "SELECT count(*) FROM card_transactions WHERE card_owner_id = 'aud-owner'" | tr -d '[:space:]')"
  [[ "$aud_count" == "1" ]] || { echo "replay created a second AUD row" >&2; exit 1; }

  local mismatch="$root/mismatch"
  mkdir -p "$mismatch"
  printf '%s' '{"cardOwnerId":"aud-owner","merchant":"  Cafe   Nero ","amount":"12.35","currency":"aud","txnDate":"2026-11-21","tax":"1.10"}' >"$mismatch/request.json"
  code="$(post_json "$mismatch" "$BASE_URL/transactions" "aud-key-1" "$mismatch/request.json" "$api")"
  [[ "$code" == "422" ]] || { echo "mismatch HTTP $code" >&2; exit 1; }
  aud_count="$(psql_exec -tAc "SELECT count(*) FROM card_transactions WHERE card_owner_id = 'aud-owner'" | tr -d '[:space:]')"
  [[ "$aud_count" == "1" ]] || { echo "mismatch created a row" >&2; exit 1; }

  local jpy="$root/jpy"
  mkdir -p "$jpy"
  printf '%s' '{"cardOwnerId":"jpy-owner","merchant":"Cafe","amount":"500","currency":"JPY","txnDate":"2026-11-21"}' >"$jpy/request.json"
  code="$(post_json "$jpy" "$BASE_URL/transactions" "jpy-key-1" "$jpy/request.json" "$api")"
  [[ "$code" == "201" ]] || { echo "jpy HTTP $code" >&2; exit 1; }
  local jpy_minor
  jpy_minor="$(psql_exec -tAc "SELECT amount_minor FROM card_transactions WHERE card_owner_id = 'jpy-owner'" | tr -d '[:space:]')"
  [[ "$jpy_minor" == "500" ]] || { echo "jpy minor was $jpy_minor" >&2; exit 1; }
  local jpy_bad="$root/jpy-decimal"
  mkdir -p "$jpy_bad"
  printf '%s' '{"cardOwnerId":"jpy-bad-owner","merchant":"Cafe","amount":"500.0","currency":"JPY","txnDate":"2026-11-21"}' >"$jpy_bad/request.json"
  code="$(post_json "$jpy_bad" "$BASE_URL/transactions" "jpy-bad-key" "$jpy_bad/request.json" "$api")"
  [[ "$code" == "400" ]] || { echo "jpy decimal HTTP $code" >&2; exit 1; }

  local document="$root/document"
  mkdir -p "$document"
  printf '%s' '{"kind":"RECEIPT","cardOwnerId":"doc-owner","merchant":"Cafe","amount":"9.99","currency":"AUD","docDate":"2026-11-21"}' >"$document/request.json"
  code="$(post_json "$document" "$BASE_URL/documents" "doc-key-1" "$document/request.json" "$api")"
  [[ "$code" == "201" ]] || { echo "document HTTP $code" >&2; exit 1; }
  psql_exec -c "SELECT kind, amount_minor FROM documents WHERE card_owner_id = 'doc-owner'" >"$document/row.txt"
  grep -q 'RECEIPT' "$document/row.txt" && grep -q '999' "$document/row.txt" || { echo "document row missing" >&2; exit 1; }

  local inflight="$root/in-flight"
  mkdir -p "$inflight"
  printf '%s' '{"cardOwnerId":"inflight-owner","merchant":"Cafe","amount":"3.00","currency":"AUD","txnDate":"2026-11-21"}' >"$inflight/request.json"
  local hash
  hash="$(sha256sum "$inflight/request.json" | awk '{print $1}')"
  printf '%s\n' "$hash" >"$inflight/request.sha256"
  psql_exec -v hash="$hash" <<'SQL' >"$inflight/insert-stdout.txt" 2>"$inflight/insert-stderr.txt"
INSERT INTO idempotency_keys (key, endpoint, request_hash)
VALUES ('inflight-key', 'POST /transactions', :'hash');
SQL
  code="$(post_json "$inflight" "$BASE_URL/transactions" "inflight-key" "$inflight/request.json" "$api")"
  [[ "$code" == "409" ]] || { echo "in-flight HTTP $code" >&2; exit 1; }
  grep -qi '^retry-after: 1' "$inflight/headers.txt" || { echo "missing Retry-After: 1" >&2; cat "$inflight/headers.txt" >&2; exit 1; }
  local inflight_rows
  inflight_rows="$(psql_exec -tAc "SELECT count(*) FROM card_transactions WHERE card_owner_id = 'inflight-owner'" | tr -d '[:space:]')"
  [[ "$inflight_rows" == "0" ]] || { echo "in-flight stored a transaction" >&2; exit 1; }

  echo "ingest passed"
}

reconcile_empty() {
  local dir="$1"
  local url="$2"
  local idem="$3"
  mkdir -p "$dir"
  echo "curl -X POST -H X-API-Key -H Idempotency-Key:$idem --data-binary <empty> $url" >"$dir/command.txt"
  local code
  code="$(curl -sS --max-time 30 -D "$dir/headers.txt" -o "$dir/body.json" -w '%{http_code}' \
    -H 'X-API-Key: local-dev-key' \
    -H "Idempotency-Key: $idem" \
    --data-binary '' \
    "$url" 2>"$dir/stderr.txt")"
  printf '%s\n' "$code" >"$dir/http-status.txt"
  printf '%s\n' "$code"
}

get_url() {
  local dir="$1"
  local url="$2"
  mkdir -p "$dir"
  echo "curl $url" >"$dir/command.txt"
  local code
  code="$(curl -sS --max-time 30 -D "$dir/headers.txt" -o "$dir/body.json" -w '%{http_code}' \
    "$url" 2>"$dir/stderr.txt")"
  printf '%s\n' "$code" >"$dir/http-status.txt"
  printf '%s\n' "$code"
}

drive_reconcile() {
  local root="$EVIDENCE_DIR/reconcile"
  local api="local-dev-key"
  mkdir -p "$root"
  local code
  code="$(curl -sS --max-time 20 -o "$root/prometheus-before.txt" -w '%{http_code}' "$BASE_URL/actuator/prometheus" 2>"$root/prometheus-before.stderr.txt")"
  [[ "$code" == "200" ]] || { echo "prometheus before HTTP $code" >&2; exit 1; }

  printf '%s' '{"cardOwnerId":"auto-owner","merchant":"Cafe Nero","amount":"12.34","currency":"AUD","txnDate":"2026-11-21","tax":"1.10"}' >"$root/auto-txn.json"
  code="$(post_json "$root/auto-txn" "$BASE_URL/transactions" "recon-auto-txn" "$root/auto-txn.json" "$api")"
  [[ "$code" == "201" ]] || { echo "auto transaction HTTP $code" >&2; exit 1; }
  printf '%s' '{"kind":"RECEIPT","cardOwnerId":"auto-owner","merchant":"Cafe Nero","amount":"12.34","currency":"AUD","docDate":"2026-11-21","tax":"1.10"}' >"$root/auto-doc.json"
  code="$(post_json "$root/auto-doc" "$BASE_URL/documents" "recon-auto-doc" "$root/auto-doc.json" "$api")"
  [[ "$code" == "201" ]] || { echo "auto document HTTP $code" >&2; exit 1; }

  local auto_txn auto_doc
  auto_txn="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["id"])' "$root/auto-txn/body.json")"
  auto_doc="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["id"])' "$root/auto-doc/body.json")"
  code="$(reconcile_empty "$root/auto" "$BASE_URL/reconcile/$auto_txn" "recon-auto")"
  [[ "$code" == "200" ]] || { echo "auto reconcile HTTP $code" >&2; cat "$root/auto/body.json" >&2; exit 1; }
  local auto_match
  auto_match="$(python3 - "$root/auto/body.json" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body["status"] != "APPROVED":
    raise SystemExit(f"auto status {body['status']}")
if abs(float(body["score"]) - 1.0) > 0.0001:
    raise SystemExit(f"auto score {body['score']}")
if "R5_MERCHANT" not in body["rulesFired"] or "R6_TAX" not in body["rulesFired"]:
    raise SystemExit(f"auto rules {body['rulesFired']}")
print(body["matchId"])
PY
)"

  code="$(get_url "$root/auto-get" "$BASE_URL/matches/$auto_match")"
  [[ "$code" == "200" ]] || { echo "auto get HTTP $code" >&2; exit 1; }
  python3 - "$root/auto-get/body.json" "$auto_doc" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body["status"] != "APPROVED" or body["decidedBy"] != "system:auto-approve":
    raise SystemExit(f"stored match {body}")
if body["documentId"] != sys.argv[2]:
    raise SystemExit(f"document {body['documentId']}")
if body["version"] != 0:
    raise SystemExit(f"version {body['version']}")
PY

  code="$(get_url "$root/auto-history" "$BASE_URL/matches/$auto_match/history")"
  [[ "$code" == "200" ]] || { echo "history HTTP $code" >&2; exit 1; }
  python3 - "$root/auto-history/body.json" <<'PY'
import json, pathlib, sys
events = json.loads(pathlib.Path(sys.argv[1]).read_text())
if len(events) != 2:
    raise SystemExit(f"history length {len(events)}")
if events[0]["eventType"] != "MATCHED" or events[0]["actor"] != "system:matching":
    raise SystemExit(f"first event {events[0]}")
if events[1]["eventType"] != "APPROVED" or events[1]["actor"] != "system:auto-approve":
    raise SystemExit(f"second event {events[1]}")
after = events[1]["after"]
if after["ruleSetVersion"] != "r1-r6.v1":
    raise SystemExit(f"rule set {after.get('ruleSetVersion')}")
if abs(float(after["threshold"]) - 0.95) > 0.0001:
    raise SystemExit(f"threshold {after.get('threshold')}")
PY
  local outbox
  outbox="$(psql_exec -tAc "SELECT count(*) FROM outbox WHERE aggregate_id = '$auto_match' AND event_type = 'MatchConfirmed'" | tr -d '[:space:]')"
  [[ "$outbox" == "1" ]] || { echo "outbox count $outbox" >&2; exit 1; }

  printf '%s' '{"cardOwnerId":"none-owner","merchant":"Lonely Cafe","amount":"20.00","currency":"AUD","txnDate":"2026-11-21"}' >"$root/none-txn.json"
  code="$(post_json "$root/none-txn" "$BASE_URL/transactions" "recon-none-txn" "$root/none-txn.json" "$api")"
  [[ "$code" == "201" ]] || { echo "none transaction HTTP $code" >&2; exit 1; }
  local none_txn
  none_txn="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["id"])' "$root/none-txn/body.json")"
  code="$(reconcile_empty "$root/none" "$BASE_URL/reconcile/$none_txn" "recon-none")"
  [[ "$code" == "200" ]] || { echo "none reconcile HTTP $code" >&2; cat "$root/none/body.json" >&2; exit 1; }
  python3 - "$root/none/body.json" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body["status"] != "EXCEPTION" or body["score"] is not None:
    raise SystemExit(f"none body {body}")
if '"score": null' not in pathlib.Path(sys.argv[1]).read_text() and '"score":null' not in pathlib.Path(sys.argv[1]).read_text():
    raise SystemExit("score was not JSON null")
PY
  local none_match
  none_match="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["matchId"])' "$root/none/body.json")"
  code="$(get_url "$root/none-get" "$BASE_URL/matches/$none_match")"
  [[ "$code" == "200" ]] || { echo "none get HTTP $code" >&2; exit 1; }
  python3 - "$root/none-get/body.json" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body["exceptionType"] != "NO_CANDIDATE" or body["documentId"] is not None or body["score"] is not None:
    raise SystemExit(f"none match {body}")
if body["decidedBy"] is not None:
    raise SystemExit("NO_CANDIDATE was auto-approved")
PY

  printf '%s' '{"cardOwnerId":"mismatch-owner","merchant":"Cafe Nero","amount":"50.00","currency":"AUD","txnDate":"2026-11-21","tax":"5.00"}' >"$root/mismatch-txn.json"
  code="$(post_json "$root/mismatch-txn" "$BASE_URL/transactions" "recon-mismatch-txn" "$root/mismatch-txn.json" "$api")"
  [[ "$code" == "201" ]] || { echo "mismatch transaction HTTP $code" >&2; exit 1; }
  printf '%s' '{"kind":"RECEIPT","cardOwnerId":"mismatch-owner","merchant":"Cafe Nero","amount":"55.00","currency":"AUD","docDate":"2026-11-21","tax":"5.00"}' >"$root/mismatch-doc.json"
  code="$(post_json "$root/mismatch-doc" "$BASE_URL/documents" "recon-mismatch-doc" "$root/mismatch-doc.json" "$api")"
  [[ "$code" == "201" ]] || { echo "mismatch document HTTP $code" >&2; exit 1; }
  local mismatch_txn mismatch_doc
  mismatch_txn="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["id"])' "$root/mismatch-txn/body.json")"
  mismatch_doc="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["id"])' "$root/mismatch-doc/body.json")"
  code="$(reconcile_empty "$root/mismatch" "$BASE_URL/reconcile/$mismatch_txn" "recon-mismatch")"
  [[ "$code" == "200" ]] || { echo "mismatch reconcile HTTP $code" >&2; cat "$root/mismatch/body.json" >&2; exit 1; }
  local mismatch_match
  mismatch_match="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["matchId"])' "$root/mismatch/body.json")"
  code="$(get_url "$root/mismatch-get" "$BASE_URL/matches/$mismatch_match")"
  [[ "$code" == "200" ]] || { echo "mismatch get HTTP $code" >&2; exit 1; }
  python3 - "$root/mismatch-get/body.json" "$mismatch_doc" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body["status"] != "EXCEPTION" or body["exceptionType"] != "AMOUNT_MISMATCH":
    raise SystemExit(f"mismatch {body}")
if body["documentId"] != sys.argv[2] or body["score"] is None or body["decidedBy"] is not None:
    raise SystemExit(f"held receipt {body}")
PY

  printf '%s' '{"cardOwnerId":"mismatch-owner","merchant":"Cafe Nero","amount":"55.00","currency":"AUD","txnDate":"2026-11-21","tax":"5.00"}' >"$root/second-txn.json"
  code="$(post_json "$root/second-txn" "$BASE_URL/transactions" "recon-second-txn" "$root/second-txn.json" "$api")"
  [[ "$code" == "201" ]] || { echo "second transaction HTTP $code" >&2; exit 1; }
  local second_txn
  second_txn="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["id"])' "$root/second-txn/body.json")"
  code="$(reconcile_empty "$root/second" "$BASE_URL/reconcile/$second_txn" "recon-second")"
  [[ "$code" == "200" ]] || { echo "second reconcile HTTP $code" >&2; cat "$root/second/body.json" >&2; exit 1; }
  local second_match
  second_match="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["matchId"])' "$root/second/body.json")"
  code="$(get_url "$root/second-get" "$BASE_URL/matches/$second_match")"
  [[ "$code" == "200" ]] || { echo "second get HTTP $code" >&2; exit 1; }
  python3 - "$root/second-get/body.json" "$mismatch_doc" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body["status"] != "EXCEPTION" or body["exceptionType"] != "NO_CANDIDATE":
    raise SystemExit(f"second {body}")
if body["documentId"] is not None or body["documentId"] == sys.argv[2]:
    raise SystemExit("second charge took the held receipt")
PY

  code="$(curl -sS --max-time 20 -o "$root/prometheus-after.txt" -w '%{http_code}' "$BASE_URL/actuator/prometheus" 2>"$root/prometheus-after.stderr.txt")"
  [[ "$code" == "200" ]] || { echo "prometheus after HTTP $code" >&2; exit 1; }
  python3 - "$root/prometheus-before.txt" "$root/prometheus-after.txt" <<'PY'
import pathlib, re, sys
def value(text, name, required):
    total = 0.0
    seen = False
    for line in text.splitlines():
        if line.startswith("#") or not line.startswith(name):
            continue
        head, _, number = line.partition(" ")
        if head != name and not head.startswith(name + "{"):
            continue
        if any(part not in head for part in required):
            continue
        total += float(number)
        seen = True
    return total if seen else 0.0
before = pathlib.Path(sys.argv[1]).read_text()
after = pathlib.Path(sys.argv[2]).read_text()
checks = [
    ("recon_auto_approvals_total", (), 1),
    ("recon_matches_total", ('result="MATCHED"',), 1),
    ("recon_matches_total", ('result="EXCEPTION"',), 3),
    ("recon_exceptions_total", ('type="NO_CANDIDATE"',), 2),
    ("recon_exceptions_total", ('type="AMOUNT_MISMATCH"',), 1),
]
for name, labels, delta in checks:
    got = value(after, name, labels) - value(before, name, labels)
    if abs(got - delta) > 0.001:
        raise SystemExit(f"{name} {labels} delta {got}, want {delta}")
if "recon_match_latency_seconds" not in after:
    raise SystemExit("recon_match_latency_seconds missing")
PY
  echo "reconcile passed"
}

drive_decisions() {
  local root="$EVIDENCE_DIR/decisions"
  local api="local-dev-key"
  mkdir -p "$root"
  local code

  code="$(curl -sS --max-time 20 -o "$root/prometheus-before.txt" -w '%{http_code}' "$BASE_URL/actuator/prometheus" 2>"$root/prometheus-before.stderr.txt")"
  [[ "$code" == "200" ]] || { echo "prometheus before HTTP $code" >&2; exit 1; }

  printf '%s' '{"cardOwnerId":"suggest-owner","merchant":"Cafe","amount":"8.00","currency":"AUD","txnDate":"2026-11-21"}' >"$root/sug-txn.json"
  code="$(post_json "$root/sug-txn" "$BASE_URL/transactions" "dec-sug-txn" "$root/sug-txn.json" "$api")"
  [[ "$code" == "201" ]] || { echo "suggest transaction HTTP $code" >&2; exit 1; }
  printf '%s' '{"kind":"RECEIPT","cardOwnerId":"suggest-owner","merchant":"Cafe","amount":"8.00","currency":"AUD","docDate":"2026-11-21"}' >"$root/sug-doc.json"
  code="$(post_json "$root/sug-doc" "$BASE_URL/documents" "dec-sug-doc" "$root/sug-doc.json" "$api")"
  [[ "$code" == "201" ]] || { echo "suggest document HTTP $code" >&2; exit 1; }
  local sug_txn
  sug_txn="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["id"])' "$root/sug-txn/body.json")"
  code="$(reconcile_empty "$root/sug" "$BASE_URL/reconcile/$sug_txn" "dec-sug")"
  [[ "$code" == "200" ]] || { echo "suggest reconcile HTTP $code" >&2; exit 1; }
  local sug_match
  sug_match="$(python3 - "$root/sug/body.json" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body["status"] != "SUGGESTED":
    raise SystemExit(f"suggest status {body['status']}")
if abs(float(body["score"]) - 0.7) > 0.001:
    raise SystemExit(f"suggest score {body['score']}")
print(body["matchId"])
PY
)"
  code="$(get_url "$root/sug-get" "$BASE_URL/matches/$sug_match")"
  [[ "$code" == "200" ]] || { echo "suggest get HTTP $code" >&2; exit 1; }
  python3 - "$root/sug-get/body.json" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body["version"] != 0 or body["status"] != "SUGGESTED" or body["decidedBy"] is not None:
    raise SystemExit(f"suggest match {body}")
PY

  printf '%s' '{"version":0,"actor":"sam","reason":"looks right"}' >"$root/approve.json"
  code="$(post_json "$root/approve" "$BASE_URL/matches/$sug_match/approve" "dec-sug-approve" "$root/approve.json" "$api")"
  [[ "$code" == "200" ]] || { echo "approve HTTP $code" >&2; cat "$root/approve/body.json" >&2; exit 1; }
  python3 - "$root/approve/body.json" "$sug_match" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body["status"] != "APPROVED" or body["version"] != 1 or body["matchId"] != sys.argv[2]:
    raise SystemExit(f"approve body {body}")
PY

  code="$(get_url "$root/approve-history" "$BASE_URL/matches/$sug_match/history")"
  [[ "$code" == "200" ]] || { echo "approve history HTTP $code" >&2; exit 1; }
  python3 - "$root/approve-history/body.json" <<'PY'
import json, pathlib, sys
events = json.loads(pathlib.Path(sys.argv[1]).read_text())
if len(events) != 2:
    raise SystemExit(f"history length {len(events)}")
if events[0]["eventType"] != "SUGGESTED" or events[0]["actor"] != "system:matching":
    raise SystemExit(f"first {events[0]}")
if events[1]["eventType"] != "APPROVED" or events[1]["actor"] != "sam" or events[1]["reason"] != "looks right":
    raise SystemExit(f"second {events[1]}")
PY

  code="$(post_json "$root/approve-replay" "$BASE_URL/matches/$sug_match/approve" "dec-sug-approve" "$root/approve.json" "$api")"
  [[ "$code" == "200" ]] || { echo "approve replay HTTP $code" >&2; exit 1; }
  cmp -s "$root/approve/body.json" "$root/approve-replay/body.json" || { echo "replay body differs" >&2; exit 1; }
  local events outbox
  events="$(psql_exec -tAc "SELECT count(*) FROM reconciliation_events WHERE match_id = '$sug_match'" | tr -d '[:space:]')"
  [[ "$events" == "2" ]] || { echo "approve events $events" >&2; exit 1; }
  outbox="$(psql_exec -tAc "SELECT count(*) FROM outbox WHERE aggregate_id = '$sug_match' AND event_type = 'MatchConfirmed'" | tr -d '[:space:]')"
  [[ "$outbox" == "1" ]] || { echo "approve outbox $outbox" >&2; exit 1; }

  code="$(post_json "$root/stale" "$BASE_URL/matches/$sug_match/approve" "dec-sug-stale" "$root/approve.json" "$api")"
  [[ "$code" == "409" ]] || { echo "stale HTTP $code" >&2; cat "$root/stale/body.json" >&2; exit 1; }
  grep -qi 'application/problem+json' "$root/stale/headers.txt" || { echo "stale was not problem+json" >&2; exit 1; }
  python3 - "$root/stale/body.json" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body.get("status") != 409 or "stale" not in body.get("detail", "").lower():
    raise SystemExit(f"stale body {body}")
PY
  local still
  still="$(psql_exec -tAc "SELECT count(*) FROM reconciliation_events WHERE match_id = '$sug_match'" | tr -d '[:space:]')"
  [[ "$still" == "2" ]] || { echo "stale wrote an event" >&2; exit 1; }

  code="$(curl -sS --max-time 20 -o "$root/prometheus-after.txt" -w '%{http_code}' "$BASE_URL/actuator/prometheus" 2>"$root/prometheus-after.stderr.txt")"
  [[ "$code" == "200" ]] || { echo "prometheus after HTTP $code" >&2; exit 1; }
  python3 - "$root/prometheus-before.txt" "$root/prometheus-after.txt" <<'PY'
import pathlib, sys
def value(text):
    total = 0.0
    for line in text.splitlines():
        if line.startswith("#"):
            continue
        head, _, number = line.partition(" ")
        if head == "optimistic_lock_conflicts_total" or head.startswith("optimistic_lock_conflicts_total{"):
            total += float(number)
    return total
before = pathlib.Path(sys.argv[1]).read_text()
after = pathlib.Path(sys.argv[2]).read_text()
got = value(after) - value(before)
if abs(got - 1) > 0.001:
    raise SystemExit(f"optimistic_lock_conflicts_total delta {got}")
PY

  printf '%s' '{"cardOwnerId":"exception-owner","merchant":"Cafe Nero","amount":"50.00","currency":"AUD","txnDate":"2026-11-21","tax":"5.00"}' >"$root/ex-txn.json"
  code="$(post_json "$root/ex-txn" "$BASE_URL/transactions" "dec-ex-txn" "$root/ex-txn.json" "$api")"
  [[ "$code" == "201" ]] || { echo "exception transaction HTTP $code" >&2; exit 1; }
  printf '%s' '{"kind":"RECEIPT","cardOwnerId":"exception-owner","merchant":"Cafe Nero","amount":"55.00","currency":"AUD","docDate":"2026-11-21","tax":"5.00"}' >"$root/ex-doc.json"
  code="$(post_json "$root/ex-doc" "$BASE_URL/documents" "dec-ex-doc" "$root/ex-doc.json" "$api")"
  [[ "$code" == "201" ]] || { echo "exception document HTTP $code" >&2; exit 1; }
  local ex_txn
  ex_txn="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["id"])' "$root/ex-txn/body.json")"
  code="$(reconcile_empty "$root/ex" "$BASE_URL/reconcile/$ex_txn" "dec-ex")"
  [[ "$code" == "200" ]] || { echo "exception reconcile HTTP $code" >&2; exit 1; }
  local ex_match
  ex_match="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["matchId"])' "$root/ex/body.json")"
  code="$(get_url "$root/ex-get" "$BASE_URL/matches/$ex_match")"
  [[ "$code" == "200" ]] || { echo "exception get HTTP $code" >&2; exit 1; }
  python3 - "$root/ex-get/body.json" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body["status"] != "EXCEPTION" or body["exceptionType"] != "AMOUNT_MISMATCH":
    raise SystemExit(f"exception match {body}")
PY
  printf '%s' '{"version":0,"actor":"sam"}' >"$root/ex-no-reason.json"
  code="$(post_json "$root/ex-no-reason" "$BASE_URL/matches/$ex_match/approve" "dec-ex-no-reason" "$root/ex-no-reason.json" "$api")"
  [[ "$code" == "422" ]] || { echo "exception without reason HTTP $code" >&2; cat "$root/ex-no-reason/body.json" >&2; exit 1; }
  python3 - "$root/ex-no-reason/body.json" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body.get("status") != 422 or "non-empty reason" not in body.get("detail", ""):
    raise SystemExit(f"422 body {body}")
PY
  local ex_events
  ex_events="$(psql_exec -tAc "SELECT count(*) FROM reconciliation_events WHERE match_id = '$ex_match'" | tr -d '[:space:]')"
  [[ "$ex_events" == "1" ]] || { echo "exception events after 422: $ex_events" >&2; exit 1; }
  printf '%s' '{"version":0,"actor":"sam","reason":"override the amount"}' >"$root/ex-approve.json"
  code="$(post_json "$root/ex-approve" "$BASE_URL/matches/$ex_match/approve" "dec-ex-approve" "$root/ex-approve.json" "$api")"
  [[ "$code" == "200" ]] || { echo "exception approve HTTP $code" >&2; cat "$root/ex-approve/body.json" >&2; exit 1; }
  python3 - "$root/ex-approve/body.json" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body["status"] != "APPROVED" or body["version"] != 1:
    raise SystemExit(f"exception approve {body}")
PY

  printf '%s' '{"cardOwnerId":"reject-owner","merchant":"Cafe","amount":"8.00","currency":"AUD","txnDate":"2026-11-21"}' >"$root/rej-txn.json"
  code="$(post_json "$root/rej-txn" "$BASE_URL/transactions" "dec-rej-txn" "$root/rej-txn.json" "$api")"
  [[ "$code" == "201" ]] || { echo "reject transaction HTTP $code" >&2; exit 1; }
  printf '%s' '{"kind":"RECEIPT","cardOwnerId":"reject-owner","merchant":"Cafe","amount":"8.00","currency":"AUD","docDate":"2026-11-21"}' >"$root/rej-doc.json"
  code="$(post_json "$root/rej-doc" "$BASE_URL/documents" "dec-rej-doc" "$root/rej-doc.json" "$api")"
  [[ "$code" == "201" ]] || { echo "reject document HTTP $code" >&2; exit 1; }
  local rej_txn rej_doc
  rej_txn="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["id"])' "$root/rej-txn/body.json")"
  rej_doc="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["id"])' "$root/rej-doc/body.json")"
  code="$(reconcile_empty "$root/rej" "$BASE_URL/reconcile/$rej_txn" "dec-rej-recon")"
  [[ "$code" == "200" ]] || { echo "reject reconcile HTTP $code" >&2; exit 1; }
  local rej_match
  rej_match="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["matchId"])' "$root/rej/body.json")"
  printf '%s' '{"version":0,"actor":"sam","reason":"not this receipt"}' >"$root/reject.json"
  code="$(post_json "$root/reject" "$BASE_URL/matches/$rej_match/reject" "dec-rej" "$root/reject.json" "$api")"
  [[ "$code" == "200" ]] || { echo "reject HTTP $code" >&2; cat "$root/reject/body.json" >&2; exit 1; }
  python3 - "$root/reject/body.json" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body["status"] != "REJECTED" or body["version"] != 1:
    raise SystemExit(f"reject body {body}")
PY
  local charge_status rej_outbox
  charge_status="$(psql_exec -tAc "SELECT status FROM card_transactions WHERE id = '$rej_txn'" | tr -d '[:space:]')"
  [[ "$charge_status" == "UNMATCHED" ]] || { echo "charge status $charge_status" >&2; exit 1; }
  rej_outbox="$(psql_exec -tAc "SELECT count(*) FROM outbox WHERE aggregate_id = '$rej_match'" | tr -d '[:space:]')"
  [[ "$rej_outbox" == "0" ]] || { echo "reject wrote an outbox row" >&2; exit 1; }
  code="$(get_url "$root/reject-history" "$BASE_URL/matches/$rej_match/history")"
  [[ "$code" == "200" ]] || { echo "reject history HTTP $code" >&2; exit 1; }
  python3 - "$root/reject-history/body.json" <<'PY'
import json, pathlib, sys
events = json.loads(pathlib.Path(sys.argv[1]).read_text())
if len(events) != 2 or events[1]["eventType"] != "REJECTED" or events[1]["reason"] != "not this receipt":
    raise SystemExit(f"reject history {events}")
PY

  code="$(reconcile_empty "$root/rej-again" "$BASE_URL/reconcile/$rej_txn" "dec-rej-again")"
  [[ "$code" == "200" ]] || { echo "re-reconcile HTTP $code" >&2; cat "$root/rej-again/body.json" >&2; exit 1; }
  python3 - "$root/rej-again/body.json" "$rej_match" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body["matchId"] != sys.argv[2] or body["status"] != "SUGGESTED":
    raise SystemExit(f"re-match did not reuse the row: {body}")
PY
  local match_rows
  match_rows="$(psql_exec -tAc "SELECT count(*) FROM matches WHERE transaction_id = '$rej_txn'" | tr -d '[:space:]')"
  [[ "$match_rows" == "1" ]] || { echo "re-match row count $match_rows" >&2; exit 1; }
  code="$(get_url "$root/rematch-history" "$BASE_URL/matches/$rej_match/history")"
  [[ "$code" == "200" ]] || { echo "re-match history HTTP $code" >&2; exit 1; }
  python3 - "$root/rematch-history/body.json" "$rej_doc" <<'PY'
import json, pathlib, sys
events = json.loads(pathlib.Path(sys.argv[1]).read_text())
types = [event["eventType"] for event in events]
if types != ["SUGGESTED", "REJECTED", "SUGGESTED"]:
    raise SystemExit(f"re-match history {types}")
last = events[2]
if last["before"]["status"] != "REJECTED" or last["after"]["documentId"] != sys.argv[2]:
    raise SystemExit(f"re-match event {last}")
PY
  printf '%s' '{"version":2,"actor":"sam","reason":"free it again"}' >"$root/reject-again.json"
  code="$(post_json "$root/reject-again" "$BASE_URL/matches/$rej_match/reject" "dec-rej-free" "$root/reject-again.json" "$api")"
  [[ "$code" == "200" ]] || { echo "second reject HTTP $code" >&2; cat "$root/reject-again/body.json" >&2; exit 1; }

  printf '%s' '{"cardOwnerId":"reject-owner","merchant":"Cafe","amount":"8.00","currency":"AUD","txnDate":"2026-11-21"}' >"$root/rej-second.json"
  code="$(post_json "$root/rej-second-txn" "$BASE_URL/transactions" "dec-rej-second-txn" "$root/rej-second.json" "$api")"
  [[ "$code" == "201" ]] || { echo "second transaction HTTP $code" >&2; exit 1; }
  local second_txn
  second_txn="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["id"])' "$root/rej-second-txn/body.json")"
  code="$(reconcile_empty "$root/rej-second" "$BASE_URL/reconcile/$second_txn" "dec-rej-second")"
  [[ "$code" == "200" ]] || { echo "second reconcile HTTP $code" >&2; cat "$root/rej-second/body.json" >&2; exit 1; }
  local second_match
  second_match="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["matchId"])' "$root/rej-second/body.json")"
  code="$(get_url "$root/rej-second-get" "$BASE_URL/matches/$second_match")"
  [[ "$code" == "200" ]] || { echo "second get HTTP $code" >&2; exit 1; }
  python3 - "$root/rej-second-get/body.json" "$rej_doc" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body["documentId"] != sys.argv[2]:
    raise SystemExit(f"second charge did not take the freed receipt: {body}")
if body["status"] != "SUGGESTED":
    raise SystemExit(f"second status {body['status']}")
PY

  local i published
  for i in $(seq 1 20); do
    published="$(psql_exec -tAc "SELECT count(*) FROM outbox WHERE aggregate_id IN ('$sug_match', '$ex_match') AND event_type = 'MatchConfirmed' AND published_at IS NOT NULL" | tr -d '[:space:]')"
    printf 'try %s published=%s\n' "$i" "$published" >>"$root/outbox-wait.log"
    if [[ "$published" == "2" ]]; then
      break
    fi
    sleep 1
  done
  [[ "$published" == "2" ]] || { echo "outbox did not publish both rows" >&2; exit 1; }
  psql_exec -c "SELECT aggregate_id, event_type, published_at IS NOT NULL AS published FROM outbox WHERE aggregate_id IN ('$sug_match', '$ex_match')" >"$root/outbox-rows.txt"
  echo "decisions passed"
}


# Sum of idempotent_replays_total samples in a Prometheus text scrape.
# Exits 1 when the metric line is absent.
counter_value() {
  awk '
    /^#/ { next }
    $1 ~ /^idempotent_replays_total($|\{)/ { sum += $NF; seen = 1 }
    END {
      if (!seen) exit 1
      printf "%.0f\n", sum + 0
    }
  ' "$1"
}

target_is_up() {
  python3 - "$1" <<'PY'
import json, sys
doc = json.load(open(sys.argv[1]))
for target in doc.get("data", {}).get("activeTargets", []):
    url = target.get("scrapeUrl") or ""
    job = (target.get("labels") or {}).get("job")
    if job == "spend-recon" and target.get("health") == "up" and "app:8080/actuator/prometheus" in url:
        sys.exit(0)
sys.exit(1)
PY
}

prom_query_matches() {
  python3 - "$1" "$2" <<'PY'
import json, sys
doc = json.load(open(sys.argv[1]))
want = float(sys.argv[2])
if doc.get("status") != "success":
    sys.exit(1)
total = 0.0
seen = False
for item in doc.get("data", {}).get("result", []):
    value = item.get("value")
    if isinstance(value, list) and len(value) >= 2:
        total += float(value[1])
        seen = True
sys.exit(0 if seen and abs(total - want) < 0.001 else 1)
PY
}

drive_grafana() {
  local dir="$EVIDENCE_DIR/grafana"
  local prom="http://127.0.0.1:9090"
  local graf="http://127.0.0.1:3000"
  local user="admin"
  local pass="admin"
  mkdir -p "$dir"
  if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 is required to read the Prometheus and Grafana JSON." >&2
    exit 1
  fi

  {
    echo "curl $BASE_URL/actuator/health"
    echo "curl $BASE_URL/actuator/prometheus"
    echo "curl $prom/api/v1/targets"
    echo "curl $prom/api/v1/query?query=idempotent_replays_total"
    echo "curl -u ${user}:${pass} $graf/api/dashboards/uid/spend-recon"
    echo "curl -u ${user}:${pass} $graf/api/ds/query expr=idempotent_replays_total"
    echo "POST $BASE_URL/transactions Idempotency-Key: grafana-replay-1 twice"
  } >"$dir/command.txt"

  local code
  code="$(curl_capture "$dir/health" "$BASE_URL/actuator/health" "$dir/health/body.json" "$dir/health/http-status.txt")"
  [[ "$code" == "200" ]] || { echo "health HTTP $code" >&2; exit 1; }
  grep -q '"status":"UP"' "$dir/health/body.json" || { echo "health was not UP" >&2; exit 1; }

  code="$(curl_capture "$dir/app-prometheus" "$BASE_URL/actuator/prometheus" "$dir/app-prometheus/body.txt" "$dir/app-prometheus/http-status.txt")"
  [[ "$code" == "200" ]] || { echo "app prometheus HTTP $code" >&2; exit 1; }
  local before
  before="$(counter_value "$dir/app-prometheus/body.txt")" || { echo "app scrape has no idempotent_replays_total" >&2; exit 1; }
  printf '%s\n' "$before" >"$dir/replay-count-before.txt"

  local replay="$dir/replay"
  printf '%s' '{"cardOwnerId":"grafana-replay-owner","merchant":"Cafe","amount":"1.00","currency":"AUD","txnDate":"2026-11-21"}' >"$dir/replay-request.json"
  code="$(post_json "$replay/first" "$BASE_URL/transactions" "grafana-replay-1" "$dir/replay-request.json")"
  [[ "$code" == "201" ]] || { echo "first replay post HTTP $code" >&2; exit 1; }
  code="$(post_json "$replay/second" "$BASE_URL/transactions" "grafana-replay-1" "$dir/replay-request.json")"
  [[ "$code" == "201" ]] || { echo "second replay post HTTP $code" >&2; exit 1; }
  python3 - "$replay/first/body.json" "$replay/second/body.json" <<'PY' || { echo "replay ids differ" >&2; exit 1; }
import json, sys
first = json.load(open(sys.argv[1]))
second = json.load(open(sys.argv[2]))
sys.exit(0 if first.get("id") and first["id"] == second.get("id") else 1)
PY

  code="$(curl_capture "$dir/app-prometheus-after" "$BASE_URL/actuator/prometheus" "$dir/app-prometheus-after/body.txt" "$dir/app-prometheus-after/http-status.txt")"
  [[ "$code" == "200" ]] || { echo "app prometheus after HTTP $code" >&2; exit 1; }
  local after
  after="$(counter_value "$dir/app-prometheus-after/body.txt")" || { echo "app scrape lost idempotent_replays_total" >&2; exit 1; }
  printf '%s\n' "$after" >"$dir/replay-count-after.txt"
  [[ "$after" -eq $((before + 1)) ]] || { echo "idempotent_replays_total went from $before to $after, expected +1. Use a fresh RUN_ID." >&2; exit 1; }

  local i up=0
  for i in $(seq 1 45); do
    code="$(curl -sS --max-time 5 -o "$dir/targets.json" -w '%{http_code}' "$prom/api/v1/targets" 2>"$dir/targets.stderr" || true)"
    if [[ "$code" == "200" ]] && target_is_up "$dir/targets.json"; then
      up=1
      break
    fi
    sleep 2
  done
  [[ "$up" -eq 1 ]] || { echo "prometheus target spend-recon was not UP" >&2; exit 1; }

  local query_ok=0
  local query_url="$prom/api/v1/query?query=idempotent_replays_total"
  for i in $(seq 1 45); do
    code="$(curl -sS --max-time 5 -G -o "$dir/prometheus-query.json" -w '%{http_code}' --data-urlencode 'query=idempotent_replays_total' "$prom/api/v1/query" 2>"$dir/prometheus-query.stderr" || true)"
    if [[ "$code" == "200" ]] && prom_query_matches "$dir/prometheus-query.json" "$after"; then
      query_ok=1
      break
    fi
    sleep 2
  done
  printf '%s\n' "$query_url" >"$dir/prometheus-query-url.txt"
  [[ "$query_ok" -eq 1 ]] || { echo "prometheus query did not return idempotent_replays_total $after" >&2; exit 1; }

  local graf_ok=0
  for i in $(seq 1 45); do
    code="$(curl -sS --max-time 5 -u "$user:$pass" -o "$dir/dashboard.json" -w '%{http_code}' "$graf/api/dashboards/uid/spend-recon" 2>"$dir/dashboard.stderr" || true)"
    if [[ "$code" == "200" ]] && grep -q '"uid"[[:space:]]*:[[:space:]]*"spend-recon"' "$dir/dashboard.json"; then
      graf_ok=1
      break
    fi
    sleep 2
  done
  printf '%s\n' "$code" >"$dir/dashboard-status.txt"
  [[ "$graf_ok" -eq 1 ]] || { echo "grafana dashboard HTTP $code" >&2; exit 1; }
  local metric
  for metric in recon_matches_total recon_match_latency_seconds recon_exceptions_total idempotent_replays_total recon_auto_approvals_total optimistic_lock_conflicts_total outbox_lag_seconds; do
    grep -q "$metric" "$dir/dashboard.json" || { echo "dashboard missing $metric" >&2; exit 1; }
  done

  cat >"$dir/query.json" <<'JSON'
{
  "from": "now-15m",
  "to": "now",
  "queries": [
    {
      "refId": "A",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "expr": "idempotent_replays_total",
      "instant": true,
      "range": false,
      "intervalMs": 15000,
      "maxDataPoints": 1
    }
  ]
}
JSON
  code="$(curl -sS --max-time 15 -u "$user:$pass" -H 'Content-Type: application/json' -d @"$dir/query.json" -o "$dir/grafana-query.json" -w '%{http_code}' "$graf/api/ds/query" 2>"$dir/grafana-query.stderr" || true)"
  printf '%s\n' "$code" >"$dir/grafana-query-status.txt"
  [[ "$code" == "200" ]] || { echo "grafana query HTTP $code" >&2; exit 1; }
  python3 - "$dir/grafana-query.json" "$after" <<'PY' || { echo "grafana query did not return idempotent_replays_total $after" >&2; exit 1; }
import json, sys
doc = json.load(open(sys.argv[1]))
want = float(sys.argv[2])
result = doc.get("results", {}).get("A", {})
if result.get("error"):
    print(result["error"], file=sys.stderr)
    sys.exit(1)
status = result.get("status", 200)
if status not in (200, "200"):
    sys.exit(1)
total = 0.0
seen = False
for frame in result.get("frames") or []:
    values = (frame.get("data") or {}).get("values") or []
    if len(values) < 2:
        continue
    for value in values[1]:
        if isinstance(value, (int, float)) and not isinstance(value, bool):
            total += float(value)
            seen = True
if not seen or abs(total - want) >= 0.001:
    print(f"grafana total={total if seen else 'none'} want={want}", file=sys.stderr)
    sys.exit(1)
PY
  echo "grafana passed"
}

drive_kind() {
  require_run_id
  # shellcheck source=../../../../scripts/kind-lib.sh
  source "$ROOT/scripts/kind-lib.sh"
  local cluster
  cluster="$(kind_cluster_name)"
  EVIDENCE_DIR="$(evidence_dir)"
  BASE_URL="http://127.0.0.1:${KIND_HOST_PORT:-8080}"
  mkdir -p "$EVIDENCE_DIR/kind"
  cat >"$EVIDENCE_DIR/run.env" <<EOF
RUN_ID=$RUN_ID
PROJECT=kind
EVIDENCE_DIR=$EVIDENCE_DIR
BASE_URL=$BASE_URL
KIND_CLUSTER=$cluster
EOF

  kind_down_once() {
    if [[ "${KIND_DOWN_DONE:-0}" -eq 1 ]]; then
      return 0
    fi
    KIND_DOWN_DONE=1
    "$ROOT/scripts/kind-down.sh" 2>&1 | tee "$EVIDENCE_DIR/kind/down.txt"
  }
  trap 'status=$?; kind_down_once || status=1; exit "$status"' EXIT

  echo "Removing a previous kind cluster named ${cluster} when this repo created it."
  "$ROOT/scripts/kind-down.sh" 2>&1 | tee "$EVIDENCE_DIR/kind/down-before.txt"

  echo "Starting kind"
  "$ROOT/scripts/kind-up.sh" 2>&1 | tee "$EVIDENCE_DIR/kind/up.txt"

  local code
  echo "curl $BASE_URL/actuator/health" >"$EVIDENCE_DIR/kind/health-command.txt"
  code="$(curl_capture "$EVIDENCE_DIR/kind/health" "$BASE_URL/actuator/health" "$EVIDENCE_DIR/kind/health/body.json" "$EVIDENCE_DIR/kind/health/http-status.txt")"
  [[ "$code" == "200" ]] || { echo "kind health HTTP $code" >&2; exit 1; }
  grep -q '"status":"UP"' "$EVIDENCE_DIR/kind/health/body.json" || { echo "kind health was not UP" >&2; exit 1; }

  code="$(curl_capture "$EVIDENCE_DIR/kind/liveness" "$BASE_URL/actuator/health/liveness" "$EVIDENCE_DIR/kind/liveness/body.json" "$EVIDENCE_DIR/kind/liveness/http-status.txt")"
  [[ "$code" == "200" ]] || { echo "kind liveness HTTP $code" >&2; exit 1; }
  grep -q '"status":"UP"' "$EVIDENCE_DIR/kind/liveness/body.json" || { echo "kind liveness was not UP" >&2; exit 1; }

  code="$(curl_capture "$EVIDENCE_DIR/kind/readiness" "$BASE_URL/actuator/health/readiness" "$EVIDENCE_DIR/kind/readiness/body.json" "$EVIDENCE_DIR/kind/readiness/http-status.txt")"
  [[ "$code" == "200" ]] || { echo "kind readiness HTTP $code" >&2; exit 1; }
  grep -q '"status":"UP"' "$EVIDENCE_DIR/kind/readiness/body.json" || { echo "kind readiness was not UP" >&2; exit 1; }

  local root="$EVIDENCE_DIR/kind/reconcile"
  local api="local-dev-key"
  mkdir -p "$root"
  printf '%s' '{"cardOwnerId":"kind-owner","merchant":"Cafe Nero","amount":"12.34","currency":"AUD","txnDate":"2026-11-21","tax":"1.10"}' >"$root/txn.json"
  code="$(post_json "$root/txn" "$BASE_URL/transactions" "kind-txn" "$root/txn.json" "$api")"
  [[ "$code" == "201" ]] || { echo "kind transaction HTTP $code" >&2; cat "$root/txn/body.json" >&2; exit 1; }
  printf '%s' '{"kind":"RECEIPT","cardOwnerId":"kind-owner","merchant":"Cafe Nero","amount":"12.34","currency":"AUD","docDate":"2026-11-21","tax":"1.10"}' >"$root/doc.json"
  code="$(post_json "$root/doc" "$BASE_URL/documents" "kind-doc" "$root/doc.json" "$api")"
  [[ "$code" == "201" ]] || { echo "kind document HTTP $code" >&2; cat "$root/doc/body.json" >&2; exit 1; }

  local txn_id
  txn_id="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["id"])' "$root/txn/body.json")"
  code="$(reconcile_empty "$root/auto" "$BASE_URL/reconcile/$txn_id" "kind-recon")"
  [[ "$code" == "200" ]] || { echo "kind reconcile HTTP $code" >&2; cat "$root/auto/body.json" >&2; exit 1; }
  local match_id
  match_id="$(python3 - "$root/auto/body.json" <<'PY'
import json, pathlib, sys
body = json.loads(pathlib.Path(sys.argv[1]).read_text())
if body.get("status") != "APPROVED":
    raise SystemExit(f"status {body.get('status')}")
score = body.get("score")
if score is None or abs(float(score) - 1.0) > 0.0001:
    raise SystemExit(f"score {score}")
print(body["matchId"])
PY
)"
  code="$(get_url "$root/history" "$BASE_URL/matches/$match_id/history")"
  [[ "$code" == "200" ]] || { echo "kind history HTTP $code" >&2; exit 1; }
  python3 - "$root/history/body.json" <<'PY'
import json, pathlib, sys
events = json.loads(pathlib.Path(sys.argv[1]).read_text())
if len(events) != 2:
    raise SystemExit(f"history length {len(events)}")
if events[0].get("eventType") != "MATCHED" or events[0].get("actor") != "system:matching":
    raise SystemExit(f"first event {events[0]}")
if events[1].get("eventType") != "APPROVED" or events[1].get("actor") != "system:auto-approve":
    raise SystemExit(f"second event {events[1]}")
PY

  local expected version failed
  expected="$(highest_migration_version)"
  kind_kubectl -n "$SPEND_RECON_NAMESPACE" exec deploy/postgres -- env PGPASSWORD=spendrecon \
    psql -v ON_ERROR_STOP=1 -U spendrecon -d spendrecon -tAc \
    "SELECT max(version::int) FROM flyway_schema_history WHERE success" \
    >"$EVIDENCE_DIR/kind/flyway-version.txt"
  kind_kubectl -n "$SPEND_RECON_NAMESPACE" exec deploy/postgres -- env PGPASSWORD=spendrecon \
    psql -v ON_ERROR_STOP=1 -U spendrecon -d spendrecon -tAc \
    "SELECT count(*) FROM flyway_schema_history WHERE success = false" \
    >"$EVIDENCE_DIR/kind/flyway-failed.txt"
  version="$(tr -d '[:space:]' <"$EVIDENCE_DIR/kind/flyway-version.txt")"
  failed="$(tr -d '[:space:]' <"$EVIDENCE_DIR/kind/flyway-failed.txt")"
  [[ "$version" == "$expected" && "$failed" == "0" ]] \
    || { echo "kind flyway version ${version:-none}, expected $expected, failed rows ${failed:-unknown}" >&2; exit 1; }

  echo "Checks passed. Deleting the cluster."
  kind_down_once
  echo "kind passed"
}

drive() {
  local feature="${1:-}"
  if [[ "$feature" == "kind" ]]; then
    drive_kind
    return
  fi
  load_run
  case "$feature" in
    health) drive_health ;;
    prometheus) drive_prometheus ;;
    scalar) drive_scalar ;;
    schema) drive_schema ;;
    audit) drive_audit ;;
    ingest) drive_ingest ;;
    reconcile) drive_reconcile ;;
    decisions) drive_decisions ;;
    grafana) drive_grafana ;;
    *)
      echo "Unknown feature '$feature'." >&2
      usage
      ;;
  esac
}

show_evidence() {
  load_run
  echo "$EVIDENCE_DIR"
  find "$EVIDENCE_DIR" -type f | sort
}

cleanup() {
  load_run
  echo "Stopping compose project $PROJECT"
  compose down --remove-orphans
  echo "Evidence kept at $EVIDENCE_DIR"
}

cmd="${1:-}"
case "$cmd" in
  launch) launch ;;
  doctor) doctor ;;
  drive) drive "${2:-}" ;;
  evidence) show_evidence ;;
  cleanup) cleanup ;;
  *) usage ;;
esac
